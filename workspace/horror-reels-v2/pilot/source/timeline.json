 "captions": [
  {
   "speaker": "NARRATOR",
   "text": "Hamare hostel\nmein raat 2 baje",
   "start_s": 0.07,
   "end_s": 2.045,
   "safe_zone": true,
   "line": 0
  },
  {
   "speaker": "NARRATOR",
   "text": "ginti hoti thi.",
   "start_s": 2.065,
   "end_s": 3.461,
   "safe_zone": true,
   "line": 0
  },
  {
   "speaker": "NARRATOR",
   "text": "Us raat, ek ladka\nzyada nikla.",
   "start_s": 3.651,
   "end_s": 6.475,
   "safe_zone": true,
   "line": 0
  },
  {
   "speaker": "NARRATOR",
   "text": "28 bed, 28 ladke.",
   "start_s": 6.645,
   "end_s": 8.07,
   "safe_zone": true,
   "line": 1
  },
  {
   "speaker": "NARRATOR",
   "text": "Warden har\nchehre pe torch",
   "start_s": 8.09,
   "end_s": 11.137,
   "safe_zone": true,
   "line": 1
  },
  {
   "speaker": "NARRATOR",
   "text": "maar kar ginta tha.",
   "start_s": 11.157,
   "end_s": 13.274,
   "safe_zone": true,
   "line": 1
  },
  {
   "speaker": "NARRATOR",
   "text": "Main kone wale bed pe,",
   "start_s": 13.344,
   "end_s": 14.913,
   "safe_zone": true,
   "line": 2
  },
  {
   "speaker": "NARRATOR",
   "text": "deewar ki taraf\nmuh karke leta tha.",
   "start_s": 14.933,
   "end_s": 17.735,
   "safe_zone": true,
   "line": 2
  },
  {
   "speaker": "NARRATOR",
   "text": "Torch mere\nbed pe aakar,",
   "start_s": 17.755,
   "end_s": 19.348,
   "safe_zone": true,
   "line": 3
  },
  {
   "speaker": "NARRATOR",
   "text": "der tak ruki rahi.",
   "start_s": 19.368,
   "end_s": 21.248,
   "safe_zone": true,
   "line": 3
  },
  {
   "speaker": "NARRATOR",
   "text": "Phir warden bola...",
   "start_s": 21.717,
   "end_s": 23.567,
   "safe_zone": true,
   "line": 4
  },
  {
   "speaker": "NARRATOR",
   "text": "29.",
   "start_s": 23.587,
   "end_s": 24.26,
   "safe_zone": true,
   "line": 4
  },
  {
   "speaker": "NARRATOR",
   "text": "Usne dobara gina.",
   "start_s": 24.531,
   "end_s": 26.026,
   "safe_zone": true,
   "line": 5
  },
  {
   "speaker": "NARRATOR",
   "text": "Phir se 29.",
   "start_s": 26.362,
   "end_s": 27.828,
   "safe_zone": true,
   "line": 5
  },
  {
   "speaker": "NARRATOR",
   "text": "Kaanpti awaaz\nmein bola,",
   "start_s": 27.998,
   "end_s": 29.796,
   "safe_zone": true,
   "line": 6
  },
  {
   "speaker": "NARRATOR",
   "text": "jo is kamre\nka nahi hai,",
   "start_s": 29.959,
   "end_s": 31.778,
   "safe_zone": true,
   "line": 6
  },
  {
   "speaker": "NARRATOR",
   "text": "wo bahar chala jaaye.",
   "start_s": 32.133,
   "end_s": 33.662,
   "safe_zone": true,
   "line": 6
  },
  {
   "speaker": "NARRATOR",
   "text": "Koi nahi utha.",
   "start_s": 34.433,
   "end_s": 35.869,
   "safe_zone": true,
   "line": 7
  },
  {
   "speaker": "NARRATOR",
   "text": "Darwaza band\nhua, aur mujhe",
   "start_s": 36.028,
   "end_s": 38.366,
   "safe_zone": true,
   "line": 7
  },
  {
   "speaker": "NARRATOR",
   "text": "laga, ginti mein\ngalti hui hai.",
   "start_s": 38.386,
   "end_s": 41.146,
   "safe_zone": true,
   "line": 7
  },
  {
   "speaker": "NARRATOR",
   "text": "Tabhi meri gardan pe\nthandi saans lagi.",
   "start_s": 41.905,
   "end_s": 44.862,
   "safe_zone": true,
   "line": 8
  },
  {
   "speaker": "NARRATOR",
   "text": "Peeche se.",
   "start_s": 45.279,
   "end_s": 46.262,
   "safe_zone": true,
   "line": 8
  },
  {
   "speaker": "NARRATOR",
   "text": "Mere hi bistar mein.",
   "start_s": 46.508,
   "end_s": 48.13,
   "safe_zone": true,
   "line": 8
  },
  {
   "speaker": "NARRATOR",
   "text": "Warden ne\nsahi gina tha.",
   "start_s": 48.9,
   "end_s": 50.908,
   "safe_zone": true,
   "line": 9
  },
  {
   "speaker": "NARRATOR",
   "text": "Agli raat, ginti mein\npoore 28 ladke aaye.",
   "start_s": 51.822,
   "end_s": 55.185,
   "safe_zone": true,
   "line": 10
  },
  {
   "speaker": "NARRATOR",
   "text": "Bas...",
   "start_s": 55.205,
   "end_s": 55.877,
   "safe_zone": true,
   "line": 10
  },
  {
   "speaker": "NARRATOR",
   "text": "main unmein nahi tha.",
   "start_s": 56.086,
   "end_s": 58.565,
   "safe_zone": true,
   "line": 10
  }
 ],
 "audio_cues": []
