 "captions": [
  {
   "speaker": "NARRATOR",
   "text": "Us dopahar,\npoore school ki",
   "start_s": 0.07,
   "end_s": 2.28,
   "safe_zone": true,
   "line": 0
  },
  {
   "speaker": "NARRATOR",
   "text": "parchhai gayab thi.",
   "start_s": 2.3,
   "end_s": 3.917,
   "safe_zone": true,
   "line": 0
  },
  {
   "speaker": "NARRATOR",
   "text": "Subah rasoi mein\ndadi ne kaha",
   "start_s": 3.987,
   "end_s": 5.631,
   "safe_zone": true,
   "line": 1
  },
  {
   "speaker": "NARRATOR",
   "text": "tha, aaj kisi ka\nhaath mat pakadna.",
   "start_s": 5.651,
   "end_s": 8.464,
   "safe_zone": true,
   "line": 1
  },
  {
   "speaker": "NARRATOR",
   "text": "Us ek minute\nmein zinda aur",
   "start_s": 8.484,
   "end_s": 10.374,
   "safe_zone": true,
   "line": 2
  },
  {
   "speaker": "NARRATOR",
   "text": "murde mein farak\nnahi rehta,",
   "start_s": 10.394,
   "end_s": 12.573,
   "safe_zone": true,
   "line": 2
  },
  {
   "speaker": "NARRATOR",
   "text": "aur parchhai sirf\nek hi lautti hai.",
   "start_s": 12.703,
   "end_s": 15.575,
   "safe_zone": true,
   "line": 2
  },
  {
   "speaker": "NARRATOR",
   "text": "Par master ji ne sabke\nhaath pakadwa diye.",
   "start_s": 15.679,
   "end_s": 18.588,
   "safe_zone": true,
   "line": 3
  },
  {
   "speaker": "NARRATOR",
   "text": "Pichle saal isi din,",
   "start_s": 18.608,
   "end_s": 20.337,
   "safe_zone": true,
   "line": 4
  },
  {
   "speaker": "NARRATOR",
   "text": "Raju kuen pe\nakela tha.",
   "start_s": 20.357,
   "end_s": 22.414,
   "safe_zone": true,
   "line": 4
  },
  {
   "speaker": "NARRATOR",
   "text": "Wapas nahi aaya.",
   "start_s": 22.509,
   "end_s": 23.875,
   "safe_zone": true,
   "line": 4
  },
  {
   "speaker": "NARRATOR",
   "text": "Phir ek ek\nkarke, sabki",
   "start_s": 23.945,
   "end_s": 25.895,
   "safe_zone": true,
   "line": 5
  },
  {
   "speaker": "NARRATOR",
   "text": "parchhai\ngayab ho gayi.",
   "start_s": 25.915,
   "end_s": 27.749,
   "safe_zone": true,
   "line": 5
  },
  {
   "speaker": "NARRATOR",
   "text": "Kisi ne mera\nhaath pakda.",
   "start_s": 27.869,
   "end_s": 29.706,
   "safe_zone": true,
   "line": 6
  },
  {
   "speaker": "NARRATOR",
   "text": "40 degree mein bhi,",
   "start_s": 29.851,
   "end_s": 31.54,
   "safe_zone": true,
   "line": 6
  },
  {
   "speaker": "NARRATOR",
   "text": "haath thanda tha.",
   "start_s": 31.56,
   "end_s": 33.086,
   "safe_zone": true,
   "line": 6
  },
  {
   "speaker": "NARRATOR",
   "text": "Wo Raju tha.",
   "start_s": 33.106,
   "end_s": 34.467,
   "safe_zone": true,
   "line": 7
  },
  {
   "speaker": "NARRATOR",
   "text": "Baal geele, boond\ntapakti hui.",
   "start_s": 34.598,
   "end_s": 37.388,
   "safe_zone": true,
   "line": 7
  },
  {
   "speaker": "NARRATOR",
   "text": "Usne dheere se kaha,",
   "start_s": 38.058,
   "end_s": 39.945,
   "safe_zone": true,
   "line": 8
  },
  {
   "speaker": "NARRATOR",
   "text": "ek hi parchhai\nlautti hai.",
   "start_s": 40.333,
   "end_s": 42.398,
   "safe_zone": true,
   "line": 8
  },
  {
   "speaker": "NARRATOR",
   "text": "Parchhaiyan lautin.",
   "start_s": 42.568,
   "end_s": 44.08,
   "safe_zone": true,
   "line": 9
  },
  {
   "speaker": "NARRATOR",
   "text": "Meri bhi.",
   "start_s": 44.334,
   "end_s": 45.331,
   "safe_zone": true,
   "line": 9
  },
  {
   "speaker": "NARRATOR",
   "text": "Maine saans li.",
   "start_s": 45.593,
   "end_s": 46.858,
   "safe_zone": true,
   "line": 9
  },
  {
   "speaker": "NARRATOR",
   "text": "Maine haath chhudaya.",
   "start_s": 46.878,
   "end_s": 48.441,
   "safe_zone": true,
   "line": 10
  },
  {
   "speaker": "NARRATOR",
   "text": "Meri parchhai\nRaju ke pairon",
   "start_s": 48.685,
   "end_s": 50.282,
   "safe_zone": true,
   "line": 10
  },
  {
   "speaker": "NARRATOR",
   "text": "se judi rahi.",
   "start_s": 50.302,
   "end_s": 51.416,
   "safe_zone": true,
   "line": 10
  },
  {
   "speaker": "NARRATOR",
   "text": "Mummy ne use mera naam\nlekar gale lagaya.",
   "start_s": 51.436,
   "end_s": 54.213,
   "safe_zone": true,
   "line": 11
  },
  {
   "speaker": "NARRATOR",
   "text": "Mujhe kisi ne\nnahi dekha.",
   "start_s": 54.527,
   "end_s": 56.309,
   "safe_zone": true,
   "line": 11
  },
  {
   "speaker": "NARRATOR",
   "text": "Parchhai gayab ho,",
   "start_s": 56.429,
   "end_s": 57.88,
   "safe_zone": true,
   "line": 12
  },
  {
   "speaker": "NARRATOR",
   "text": "to kisi ka haath\nmat pakadna.",
   "start_s": 57.9,
   "end_s": 60.009,
   "safe_zone": true,
   "line": 12
  }
 ],
