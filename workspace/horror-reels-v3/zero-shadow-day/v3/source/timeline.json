 ],
 "captions": [
  {
   "speaker": "NARRATOR",
   "text": "Saal mein ek\ndin, ek minute ke",
   "start_s": 0.07,
   "end_s": 2.396,
   "safe_zone": true,
   "line": 0
  },
  {
   "speaker": "NARRATOR",
   "text": "liye, kisi ki\nparchhai nahi hoti.",
   "start_s": 2.416,
   "end_s": 5.05,
   "safe_zone": true,
   "line": 0
  },
  {
   "speaker": "NARRATOR",
   "text": "Subah rasoi\nmein dadi bolin,",
   "start_s": 5.12,
   "end_s": 7.061,
   "safe_zone": true,
   "line": 1
  },
  {
   "speaker": "NARRATOR",
   "text": "us minute kisi ka\nhaath mat pakadna.",
   "start_s": 7.302,
   "end_s": 9.659,
   "safe_zone": true,
   "line": 1
  },
  {
   "speaker": "NARRATOR",
   "text": "Jiska haath pakdoge,",
   "start_s": 9.679,
   "end_s": 11.442,
   "safe_zone": true,
   "line": 2
  },
  {
   "speaker": "NARRATOR",
   "text": "wo tumhari\nparchhai le jayega.",
   "start_s": 11.462,
   "end_s": 13.591,
   "safe_zone": true,
   "line": 2
  },
  {
   "speaker": "NARRATOR",
   "text": "Par school mein master ji\nne sabke haath pakadwa diye.",
   "start_s": 13.611,
   "end_s": 17.005,
   "safe_zone": true,
   "line": 3
  },
  {
   "speaker": "NARRATOR",
   "text": "Mere bagal wali\njagah khaali thi.",
   "start_s": 17.025,
   "end_s": 19.405,
   "safe_zone": true,
   "line": 4
  },
  {
   "speaker": "NARRATOR",
   "text": "Raju ki jagah.",
   "start_s": 19.677,
   "end_s": 21.024,
   "safe_zone": true,
   "line": 4
  },
  {
   "speaker": "NARRATOR",
   "text": "Pichle saal wo kuen\nmein doob gaya.",
   "start_s": 21.466,
   "end_s": 24.007,
   "safe_zone": true,
   "line": 4
  },
  {
   "speaker": "NARRATOR",
   "text": "Barah bajkar\nsaat minute par,",
   "start_s": 24.027,
   "end_s": 26.403,
   "safe_zone": true,
   "line": 5
  },
  {
   "speaker": "NARRATOR",
   "text": "sabki parchhai\ngayab ho gayi.",
   "start_s": 26.423,
   "end_s": 28.668,
   "safe_zone": true,
   "line": 5
  },
  {
   "speaker": "NARRATOR",
   "text": "Tabhi kisi ne\nmera haath pakda.",
   "start_s": 28.738,
   "end_s": 30.897,
   "safe_zone": true,
   "line": 6
  },
  {
   "speaker": "NARRATOR",
   "text": "40 degree mein bhi,",
   "start_s": 31.162,
   "end_s": 32.844,
   "safe_zone": true,
   "line": 6
  },
  {
   "speaker": "NARRATOR",
   "text": "haath barf jaisa\nthanda tha.",
   "start_s": 32.864,
   "end_s": 35.224,
   "safe_zone": true,
   "line": 6
  },
  {
   "speaker": "NARRATOR",
   "text": "Maine dekha.",
   "start_s": 35.244,
   "end_s": 36.374,
   "safe_zone": true,
   "line": 7
  },
  {
   "speaker": "NARRATOR",
   "text": "Raju.",
   "start_s": 36.394,
   "end_s": 37.153,
   "safe_zone": true,
   "line": 7
  },
  {
   "speaker": "NARRATOR",
   "text": "Geele baal,\ntapakta paani.",
   "start_s": 37.173,
   "end_s": 39.581,
   "safe_zone": true,
   "line": 7
  },
  {
   "speaker": "NARRATOR",
   "text": "Usne dheere se kaha,",
   "start_s": 40.251,
   "end_s": 42.102,
   "safe_zone": true,
   "line": 8
  },
  {
   "speaker": "NARRATOR",
   "text": "teri parchhai\nab meri hai.",
   "start_s": 42.614,
   "end_s": 45.537,
   "safe_zone": true,
   "line": 8
  },
  {
   "speaker": "NARRATOR",
   "text": "Minute poora hua.",
   "start_s": 45.707,
   "end_s": 47.427,
   "safe_zone": true,
   "line": 9
  },
  {
   "speaker": "NARRATOR",
   "text": "Sabki parchhai\nlaut aayi.",
   "start_s": 47.572,
   "end_s": 49.542,
   "safe_zone": true,
   "line": 9
  },
  {
   "speaker": "NARRATOR",
   "text": "Maine saans li.",
   "start_s": 49.947,
   "end_s": 51.329,
   "safe_zone": true,
   "line": 9
  },
  {
   "speaker": "NARRATOR",
   "text": "Maine haath chhudaya.",
   "start_s": 51.349,
   "end_s": 52.889,
   "safe_zone": true,
   "line": 10
  },
  {
   "speaker": "NARRATOR",
   "text": "Par meri\nparchhai Raju ke",
   "start_s": 53.151,
   "end_s": 54.875,
   "safe_zone": true,
   "line": 10
  },
  {
   "speaker": "NARRATOR",
   "text": "pairon se judi thi.",
   "start_s": 54.895,
   "end_s": 56.511,
   "safe_zone": true,
   "line": 10
  },
  {
   "speaker": "NARRATOR",
   "text": "Gate par mummy\nne Raju ko mera",
   "start_s": 56.562,
   "end_s": 58.512,
   "safe_zone": true,
   "line": 11
  },
  {
   "speaker": "NARRATOR",
   "text": "naam lekar\ngale lagaya.",
   "start_s": 58.532,
   "end_s": 60.333,
   "safe_zone": true,
   "line": 11
  },
  {
   "speaker": "NARRATOR",
   "text": "Main cheekha.",
   "start_s": 60.353,
   "end_s": 61.547,
   "safe_zone": true,
   "line": 11
  },
  {
   "speaker": "NARRATOR",
   "text": "Kisi ne nahi suna.",
   "start_s": 61.642,
   "end_s": 63.035,
   "safe_zone": true,
   "line": 11
  },
  {
   "speaker": "NARRATOR",
