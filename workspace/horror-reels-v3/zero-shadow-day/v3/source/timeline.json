 ],
 "captions": [
  {
   "speaker": "NARRATOR",
   "text": "Saal mein ek\ndin, ek minute ke",
   "start_s": 0.07,
   "end_s": 2.452,
   "safe_zone": true,
   "line": 0
  },
  {
   "speaker": "NARRATOR",
   "text": "liye, kisi ki\nparchhai nahi hoti.",
   "start_s": 2.472,
   "end_s": 5.049,
   "safe_zone": true,
   "line": 0
  },
  {
   "speaker": "NARRATOR",
   "text": "Subah rasoi\nmein dadi bolin,",
   "start_s": 5.119,
   "end_s": 7.069,
   "safe_zone": true,
   "line": 1
  },
  {
   "speaker": "NARRATOR",
   "text": "us minute kisi ka\nhaath mat pakadna.",
   "start_s": 7.226,
   "end_s": 9.724,
   "safe_zone": true,
   "line": 1
  },
  {
   "speaker": "NARRATOR",
   "text": "Jiska haath pakdoge,",
   "start_s": 9.744,
   "end_s": 11.344,
   "safe_zone": true,
   "line": 2
  },
  {
   "speaker": "NARRATOR",
   "text": "wo tumhari\nparchhai le jayega.",
   "start_s": 11.364,
   "end_s": 13.522,
   "safe_zone": true,
   "line": 2
  },
  {
   "speaker": "NARRATOR",
   "text": "Par school mein master ji\nne sabke haath pakadwa diye.",
   "start_s": 13.542,
   "end_s": 16.721,
   "safe_zone": true,
   "line": 3
  },
  {
   "speaker": "NARRATOR",
   "text": "Mere bagal wali\njagah khaali thi.",
   "start_s": 16.741,
   "end_s": 19.104,
   "safe_zone": true,
   "line": 4
  },
  {
   "speaker": "NARRATOR",
   "text": "Raju ki jagah.",
   "start_s": 19.276,
   "end_s": 20.532,
   "safe_zone": true,
   "line": 4
  },
  {
   "speaker": "NARRATOR",
   "text": "Pichle saal wo kuen\nmein doob gaya.",
   "start_s": 20.768,
   "end_s": 23.187,
   "safe_zone": true,
   "line": 4
  },
  {
   "speaker": "NARRATOR",
   "text": "Barah bajkar\nsaat minute par,",
   "start_s": 23.207,
   "end_s": 25.45,
   "safe_zone": true,
   "line": 5
  },
  {
   "speaker": "NARRATOR",
   "text": "sabki parchhai\ngayab ho gayi.",
   "start_s": 25.47,
   "end_s": 27.625,
   "safe_zone": true,
   "line": 5
  },
  {
   "speaker": "NARRATOR",
   "text": "Tabhi kisi ne\nmera haath pakda.",
   "start_s": 27.695,
   "end_s": 29.739,
   "safe_zone": true,
   "line": 6
  },
  {
   "speaker": "NARRATOR",
   "text": "40 degree mein bhi,",
   "start_s": 29.933,
   "end_s": 31.556,
   "safe_zone": true,
   "line": 6
  },
  {
   "speaker": "NARRATOR",
   "text": "haath barf jaisa\nthanda tha.",
   "start_s": 31.576,
   "end_s": 33.767,
   "safe_zone": true,
   "line": 6
  },
  {
   "speaker": "NARRATOR",
   "text": "Maine dekha.",
   "start_s": 33.787,
   "end_s": 34.967,
   "safe_zone": true,
   "line": 7
  },
  {
   "speaker": "NARRATOR",
   "text": "Raju.",
   "start_s": 34.987,
   "end_s": 35.831,
   "safe_zone": true,
   "line": 7
  },
  {
   "speaker": "NARRATOR",
   "text": "Geele baal,\ntapakta paani.",
   "start_s": 35.936,
   "end_s": 38.572,
   "safe_zone": true,
   "line": 7
  },
  {
   "speaker": "NARRATOR",
   "text": "Usne dheere se kaha,",
   "start_s": 39.242,
   "end_s": 41.155,
   "safe_zone": true,
   "line": 8
  },
  {
   "speaker": "NARRATOR",
   "text": "teri parchhai\nab meri hai.",
   "start_s": 41.597,
   "end_s": 44.587,
   "safe_zone": true,
   "line": 8
  },
  {
   "speaker": "NARRATOR",
   "text": "Minute poora hua.",
   "start_s": 44.757,
   "end_s": 46.339,
   "safe_zone": true,
   "line": 9
  },
  {
   "speaker": "NARRATOR",
   "text": "Sabki parchhai\nlaut aayi.",
   "start_s": 46.493,
   "end_s": 48.306,
   "safe_zone": true,
   "line": 9
  },
  {
   "speaker": "NARRATOR",
   "text": "Maine saans li.",
   "start_s": 48.727,
   "end_s": 49.956,
   "safe_zone": true,
   "line": 9
  },
  {
   "speaker": "NARRATOR",
   "text": "Maine haath chhudaya.",
   "start_s": 49.976,
   "end_s": 51.552,
   "safe_zone": true,
   "line": 10
  },
  {
   "speaker": "NARRATOR",
   "text": "Par meri\nparchhai Raju ke",
   "start_s": 51.658,
   "end_s": 53.365,
   "safe_zone": true,
   "line": 10
  },
  {
   "speaker": "NARRATOR",
   "text": "pairon se judi thi.",
   "start_s": 53.385,
   "end_s": 54.864,
   "safe_zone": true,
   "line": 10
  },
  {
   "speaker": "NARRATOR",
   "text": "Gate par mummy\nne Raju ko mera",
   "start_s": 54.884,
   "end_s": 56.718,
   "safe_zone": true,
   "line": 11
  },
  {
   "speaker": "NARRATOR",
   "text": "naam lekar\ngale lagaya.",
   "start_s": 56.738,
   "end_s": 58.529,
   "safe_zone": true,
   "line": 11
  },
  {
   "speaker": "NARRATOR",
   "text": "Main cheekha.",
   "start_s": 58.602,
   "end_s": 59.871,
   "safe_zone": true,
   "line": 11
  },
  {
   "speaker": "NARRATOR",
   "text": "Kisi ne nahi suna.",
   "start_s": 60.02,
   "end_s": 61.409,
   "safe_zone": true,
   "line": 11
  },
  {
   "speaker": "NARRATOR",
   "text": "Ab har saal,\nus ek minute",
   "start_s": 61.479,
   "end_s": 63.63,
   "safe_zone": true,
   "line": 12
  },
