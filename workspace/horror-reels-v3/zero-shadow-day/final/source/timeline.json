 "captions": [
  {
   "speaker": "NARRATOR",
   "text": "Us dopahar,\npoore school ki",
   "start_s": 0.07,
   "end_s": 2.239,
   "safe_zone": true,
   "line": 0
  },
  {
   "speaker": "NARRATOR",
   "text": "parchhai gayab thi.",
   "start_s": 2.259,
   "end_s": 3.821,
   "safe_zone": true,
   "line": 0
  },
  {
   "speaker": "NARRATOR",
   "text": "Subah rasoi mein\ndadi ne kaha",
   "start_s": 3.973,
   "end_s": 5.765,
   "safe_zone": true,
   "line": 1
  },
  {
   "speaker": "NARRATOR",
   "text": "tha, aaj kisi ka\nhaath mat pakadna.",
   "start_s": 5.785,
   "end_s": 8.451,
   "safe_zone": true,
   "line": 1
  },
  {
   "speaker": "NARRATOR",
   "text": "Us ek minute\nmein zinda aur",
   "start_s": 8.471,
   "end_s": 10.317,
   "safe_zone": true,
   "line": 2
  },
  {
   "speaker": "NARRATOR",
   "text": "murde mein farak\nnahi rehta,",
   "start_s": 10.337,
   "end_s": 12.489,
   "safe_zone": true,
   "line": 2
  },
  {
   "speaker": "NARRATOR",
   "text": "aur parchhai sirf\nek hi lautti hai.",
   "start_s": 12.69,
   "end_s": 15.639,
   "safe_zone": true,
   "line": 2
  },
  {
   "speaker": "NARRATOR",
   "text": "Par master ji ne sabke\nhaath pakadwa diye.",
   "start_s": 15.742,
   "end_s": 18.577,
   "safe_zone": true,
   "line": 3
  },
  {
   "speaker": "NARRATOR",
   "text": "Pichle saal isi din,",
   "start_s": 18.597,
   "end_s": 20.304,
   "safe_zone": true,
   "line": 4
  },
  {
   "speaker": "NARRATOR",
   "text": "Raju kuen pe\nakela tha.",
   "start_s": 20.324,
   "end_s": 22.347,
   "safe_zone": true,
   "line": 4
  },
  {
   "speaker": "NARRATOR",
   "text": "Wapas nahi aaya.",
   "start_s": 22.433,
   "end_s": 23.856,
   "safe_zone": true,
   "line": 4
  },
  {
   "speaker": "NARRATOR",
   "text": "Phir ek ek\nkarke, sabki",
   "start_s": 23.926,
   "end_s": 25.753,
   "safe_zone": true,
   "line": 5
  },
  {
   "speaker": "NARRATOR",
   "text": "parchhai\ngayab ho gayi.",
   "start_s": 25.773,
   "end_s": 27.714,
   "safe_zone": true,
   "line": 5
  },
  {
   "speaker": "NARRATOR",
   "text": "Kisi ne mera\nhaath pakda.",
   "start_s": 27.834,
   "end_s": 29.624,
   "safe_zone": true,
   "line": 6
  },
  {
   "speaker": "NARRATOR",
   "text": "40 degree mein bhi,",
   "start_s": 29.753,
   "end_s": 31.291,
   "safe_zone": true,
   "line": 6
  },
  {
   "speaker": "NARRATOR",
   "text": "haath thanda tha.",
   "start_s": 31.311,
   "end_s": 33.045,
   "safe_zone": true,
   "line": 6
  },
  {
   "speaker": "NARRATOR",
   "text": "Wo Raju tha.",
   "start_s": 33.065,
   "end_s": 34.474,
   "safe_zone": true,
   "line": 7
  },
  {
   "speaker": "NARRATOR",
   "text": "Baal geele, boond\ntapakti hui.",
   "start_s": 34.557,
   "end_s": 37.33,
   "safe_zone": true,
   "line": 7
  },
  {
   "speaker": "NARRATOR",
   "text": "Usne dheere se kaha,",
   "start_s": 38,
   "end_s": 39.852,
   "safe_zone": true,
   "line": 8
  },
  {
   "speaker": "NARRATOR",
   "text": "ek hi parchhai\nlautti hai.",
   "start_s": 40.146,
   "end_s": 42.353,
   "safe_zone": true,
   "line": 8
  },
  {
   "speaker": "NARRATOR",
   "text": "Parchhaiyan lautin.",
   "start_s": 42.523,
   "end_s": 43.964,
   "safe_zone": true,
   "line": 9
  },
  {
   "speaker": "NARRATOR",
   "text": "Meri bhi.",
   "start_s": 44.289,
   "end_s": 45.328,
   "safe_zone": true,
   "line": 9
  },
  {
   "speaker": "NARRATOR",
   "text": "Maine saans li.",
   "start_s": 45.631,
   "end_s": 46.83,
   "safe_zone": true,
   "line": 9
  },
  {
   "speaker": "NARRATOR",
   "text": "Maine haath chhudaya.",
   "start_s": 46.85,
   "end_s": 48.398,
   "safe_zone": true,
   "line": 10
  },
  {
   "speaker": "NARRATOR",
   "text": "Meri parchhai\nRaju ke pairon",
   "start_s": 48.509,
   "end_s": 50.195,
   "safe_zone": true,
   "line": 10
  },
  {
   "speaker": "NARRATOR",
   "text": "se judi rahi.",
   "start_s": 50.215,
   "end_s": 51.369,
   "safe_zone": true,
   "line": 10
  },
  {
   "speaker": "NARRATOR",
   "text": "Mummy ne use mera naam\nlekar gale lagaya.",
   "start_s": 51.389,
   "end_s": 54.175,
   "safe_zone": true,
   "line": 11
  },
  {
   "speaker": "NARRATOR",
   "text": "Mujhe kisi ne\nnahi dekha.",
   "start_s": 54.434,
   "end_s": 56.256,
   "safe_zone": true,
   "line": 11
  },
  {
   "speaker": "NARRATOR",
   "text": "Parchhai gayab ho,",
   "start_s": 56.376,
   "end_s": 57.912,
   "safe_zone": true,
   "line": 12
  },
  {
   "speaker": "NARRATOR",
   "text": "to kisi ka haath\nmat pakadna.",
   "start_s": 57.932,
   "end_s": 59.963,
   "safe_zone": true,
   "line": 12
  }
 ],
