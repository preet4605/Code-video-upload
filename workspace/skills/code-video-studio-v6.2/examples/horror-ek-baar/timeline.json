  "captions": [
    {
      "speaker": "NARRATOR",
      "text": "रात को कोई एक बार पुकारे... तो जवाब मत देना।",
      "start_s": 0.25,
      "end_s": 4.938,
      "safe_zone": true
    },
    {
      "speaker": "NARRATOR",
      "text": "नानी कहती थीं, इंसान हमेशा दो बार पुकारता है।",
      "start_s": 5.988,
      "end_s": 10.207,
      "safe_zone": true
    },
    {
      "speaker": "NARRATOR",
      "text": "जो सिर्फ़ एक बार पुकारे, वो इंसान नहीं होता।",
      "start_s": 10.707,
      "end_s": 14.926,
      "safe_zone": true
    },
    {
      "speaker": "NARRATOR",
      "text": "तीन बजकर सात मिनट। माँ बगल में सो रही थीं।",
      "start_s": 15.976,
      "end_s": 20.664,
      "safe_zone": true
    },
    {
      "speaker": "NARRATOR",
      "text": "तभी रसोई से माँ की आवाज़ आई। \"बेटा।\" बस एक बार।",
      "start_s": 21.164,
      "end_s": 26.32,
      "safe_zone": true
    },
    {
      "speaker": "NARRATOR",
      "text": "मैंने जवाब नहीं दिया। पर नींद में माँ बुदबुदाईं...",
      "start_s": 27.37,
      "end_s": 31.589,
      "safe_zone": true
    },
    {
      "speaker": "WHISPER",
      "text": "हाँ...?",
      "start_s": 32.089,
      "end_s": 32.889,
      "safe_zone": true
    },
    {
      "speaker": "NARRATOR",
      "text": "माँ उठीं। चप्पलें रसोई की ओर गईं।",
      "start_s": 33.939,
      "end_s": 37.22,
      "safe_zone": true
    },
    {
      "speaker": "NARRATOR",
      "text": "दरवाज़े के नीचे की रोशनी में दो पैर रुके।",
      "start_s": 37.72,
      "end_s": 41.939,
      "safe_zone": true
    },
    {
      "speaker": "NARRATOR",
      "text": "फिर रोशनी बुझ गई।",
      "start_s": 42.439,
      "end_s": 44.314,
      "safe_zone": true
    },
    {
      "speaker": "NARRATOR",
      "text": "कुछ देर बाद चप्पलें लौटीं। माँ चुपचाप बगल में लेट गईं।",
      "start_s": 46.364,
      "end_s": 51.52,
      "safe_zone": true
    },
    {
      "speaker": "NARRATOR",
      "text": "मैं सो गया।",
      "start_s": 52.02,
      "end_s": 53.427,
      "safe_zone": true
    },
    {
      "speaker": "NARRATOR",
      "text": "सुबह रसोई से माँ ने पुकारा। \"बेटा! बेटा!\"",
      "start_s": 54.476,
      "end_s": 58.226,
      "safe_zone": true
    },
    {
      "speaker": "NARRATOR",
      "text": "दो बार। माँ रात भर रसोई में थीं।",
      "start_s": 58.726,
      "end_s": 62.476,
      "safe_zone": true
    },
    {
      "speaker": "NARRATOR",
      "text": "तो बगल में जो लेटा था...",
      "start_s": 62.976,
      "end_s": 65.789,
      "safe_zone": true
    },
    {
      "speaker": "NARRATOR",
      "text": "कंबल हिला। उसने मेरी तरफ़ मुँह किया।",
      "start_s": 67.839,
      "end_s": 71.12,
      "safe_zone": true
    },
    {
      "speaker": "WHISPER",
      "text": "\"बेटा।\"",
      "start_s": 71.62,
      "end_s": 72.42,
      "safe_zone": true
    },
    {
      "speaker": "NARRATOR",
      "text": "एक बार।",
      "start_s": 72.92,
      "end_s": 73.858,
      "safe_zone": true
    }
  ],
