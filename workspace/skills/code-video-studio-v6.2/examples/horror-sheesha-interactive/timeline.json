  "captions": [
    {
      "speaker": "NARRATOR",
      "text": "रात को शीशे में अपने पीछे कोई दिखे... तो मुड़कर मत देखना।",
      "start_s": 0.25,
      "end_s": 5.875,
      "safe_zone": true
    },
    {
      "speaker": "NARRATOR",
      "text": "दादी कहती थीं, रात को शीशा ढककर सोना।",
      "start_s": 6.925,
      "end_s": 10.675,
      "safe_zone": true
    },
    {
      "speaker": "NARRATOR",
      "text": "पीछे कोई दिखे, तो मुड़ना मत। मुड़ोगे, तो वो जान जाएगा कि तुमने\nउसे देख लिया।",
      "start_s": 11.175,
      "end_s": 18.675,
      "safe_zone": true
    },
    {
      "speaker": "NARRATOR",
      "text": "रूममेट रोहन शाम छह बजे घर चला गया था। हॉस्टल खाली था।",
      "start_s": 19.725,
      "end_s": 25.35,
      "safe_zone": true
    },
    {
      "speaker": "NARRATOR",
      "text": "रात ढाई बजे मैं ब्रश कर रहा था।",
      "start_s": 25.85,
      "end_s": 29.6,
      "safe_zone": true
    },
    {
      "speaker": "NARRATOR",
      "text": "पंखे की हवा से शीशे का तौलिया खिसककर गिर गया।",
      "start_s": 30.1,
      "end_s": 34.788,
      "safe_zone": true
    },
    {
      "speaker": "NARRATOR",
      "text": "शीशे में, मेरे पीछे, रोहन के बिस्तर पर कोई सो रहा था।",
      "start_s": 35.838,
      "end_s": 41.463,
      "safe_zone": true
    },
    {
      "speaker": "NARRATOR",
      "text": "कंबल धीरे-धीरे ऊपर-नीचे हो रहा था।",
      "start_s": 41.963,
      "end_s": 44.776,
      "safe_zone": true
    },
    {
      "speaker": "NARRATOR",
      "text": "रोहन लौट आया होगा। मैं मुस्कुराया।",
      "start_s": 45.826,
      "end_s": 48.639,
      "safe_zone": true
    },
    {
      "speaker": "NARRATOR",
      "text": "तभी फ़ोन चमका। रोहन का मैसेज। \"घर पहुँच गया, भाई।\"",
      "start_s": 49.689,
      "end_s": 54.377,
      "safe_zone": true
    },
    {
      "speaker": "NARRATOR",
      "text": "शीशे में, उसने आँखें खोलीं।",
      "start_s": 56.427,
      "end_s": 58.771,
      "safe_zone": true
    },
    {
      "speaker": "NARRATOR",
      "text": "और मेरे पीछे, असली कमरे में, कोई उठा।",
      "start_s": 59.271,
      "end_s": 63.021,
      "safe_zone": true
    },
    {
      "speaker": "NARRATOR",
      "text": "मुड़ूँ, या देखता रहूँ? A या B, कमेंट करो।",
      "start_s": 64.071,
      "end_s": 68.29,
      "safe_zone": true
    }
  ],
