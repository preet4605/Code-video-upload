  "lines": [
    {
      "index": 0,
      "speaker": "NARRATOR",
      "text": "रात को शीशे में अपने पीछे कोई दिखे... तो मुड़कर मत देखना।",
      "start_s": 0.25,
      "dur_s": 5.625
    },
    {
      "index": 1,
      "speaker": "NARRATOR",
      "text": "दादी कहती थीं, रात को शीशा ढककर सोना।",
      "start_s": 6.925,
      "dur_s": 3.75
    },
    {
      "index": 2,
      "speaker": "NARRATOR",
      "text": "पीछे कोई दिखे, तो मुड़ना मत। मुड़ोगे, तो वो जान जाएगा कि तुमने उसे देख लिया।",
      "start_s": 11.175,
      "dur_s": 7.5
    },
    {
      "index": 3,
      "speaker": "NARRATOR",
      "text": "रूममेट रोहन शाम छह बजे घर चला गया था। हॉस्टल खाली था।",
      "start_s": 19.725,
      "dur_s": 5.625
    },
    {
      "index": 4,
      "speaker": "NARRATOR",
      "text": "रात ढाई बजे मैं ब्रश कर रहा था।",
      "start_s": 25.85,
      "dur_s": 3.75
    },
    {
      "index": 5,
      "speaker": "NARRATOR",
      "text": "पंखे की हवा से शीशे का तौलिया खिसककर गिर गया।",
      "start_s": 30.1,
      "dur_s": 4.688
    },
    {
      "index": 6,
      "speaker": "NARRATOR",
      "text": "शीशे में, मेरे पीछे, रोहन के बिस्तर पर कोई सो रहा था।",
      "start_s": 35.838,
      "dur_s": 5.625
    },
    {
      "index": 7,
      "speaker": "NARRATOR",
      "text": "कंबल धीरे-धीरे ऊपर-नीचे हो रहा था।",
      "start_s": 41.963,
      "dur_s": 2.813
    },
    {
      "index": 8,
      "speaker": "NARRATOR",
      "text": "रोहन लौट आया होगा। मैं मुस्कुराया।",
      "start_s": 45.826,
      "dur_s": 2.813
    },
    {
      "index": 9,
      "speaker": "NARRATOR",
      "text": "तभी फ़ोन चमका। रोहन का मैसेज। \"घर पहुँच गया, भाई।\"",
      "start_s": 49.689,
      "dur_s": 4.688
    },
    {
      "index": 10,
      "speaker": "NARRATOR",
      "text": "शीशे में, उसने आँखें खोलीं।",
      "start_s": 56.427,
      "dur_s": 2.344
    },
    {
      "index": 11,
      "speaker": "NARRATOR",
      "text": "और मेरे पीछे, असली कमरे में, कोई उठा।",
      "start_s": 59.271,
      "dur_s": 3.75
    },
    {
      "index": 12,
      "speaker": "NARRATOR",
      "text": "मुड़ूँ, या देखता रहूँ? A या B, कमेंट करो।",
      "start_s": 64.071,
      "dur_s": 4.219
    }
  ],
