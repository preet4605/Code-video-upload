   "text": "pe, Mummy ka\nphone aaya.",
   "start_s": 2.029,
   "end_s": 4.034,
   "safe_zone": true,
   "line": 0
  },
  {
   "speaker": "NARRATOR",
   "text": "Par Mummy to\nbagal wale kamre",
   "start_s": 4.054,
   "end_s": 5.946,
   "safe_zone": true,
   "line": 1
  },
  {
   "speaker": "NARRATOR",
   "text": "mein so rahi thi.",
   "start_s": 5.966,
   "end_s": 7.435,
   "safe_zone": true,
   "line": 1
  },
  {
   "speaker": "NARRATOR",
   "text": "Maine phone uthaya,",
   "start_s": 7.455,
   "end_s": 8.905,
   "safe_zone": true,
   "line": 2
  },
  {
   "speaker": "NARRATOR",
   "text": "to Mummy ki awaaz\nbahut dheemi thi.",
   "start_s": 8.925,
   "end_s": 11.314,
   "safe_zone": true,
   "line": 2
  },
  {
   "speaker": "NARRATOR",
   "text": "Wo boli, beta,\ndarwaza mat",
   "start_s": 11.334,
   "end_s": 13.62,
   "safe_zone": true,
   "line": 3
  },
  {
   "speaker": "NARRATOR",
   "text": "kholna, chahe koi\nbhi kuch bhi bole.",
   "start_s": 13.64,
   "end_s": 16.401,
   "safe_zone": true,
   "line": 3
  },
  {
   "speaker": "NARRATOR",
   "text": "Tabhi kamre ke darwaze\npe khatkhat hui.",
   "start_s": 16.422,
   "end_s": 19.236,
   "safe_zone": true,
   "line": 4
  },
  {
   "speaker": "NARRATOR",
   "text": "Bahar se Mummy\nki awaaz aayi,",
   "start_s": 19.256,
   "end_s": 21.351,
   "safe_zone": true,
   "line": 5
  },
  {
   "speaker": "NARRATOR",
   "text": "beta khol, phone\nkyun nahi utha raha?",
   "start_s": 21.409,
   "end_s": 24.01,
   "safe_zone": true,
   "line": 5
  },
  {
   "speaker": "NARRATOR",
   "text": "Ek Mummy phone pe hai,",
   "start_s": 24.43,
   "end_s": 26.011,
   "safe_zone": true,
   "line": 6
  },
  {
   "speaker": "NARRATOR",
   "text": "aur ek darwaze pe.",
   "start_s": 26.031,
   "end_s": 27.365,
   "safe_zone": true,
   "line": 6
  },
  {
   "speaker": "NARRATOR",
   "text": "Tum kiski sunoge?",
   "start_s": 27.47,
   "end_s": 28.683,
   "safe_zone": true,
   "line": 6
  },
  {
   "speaker": "NARRATOR",
   "text": "A, phone wali Mummy.",
   "start_s": 28.703,
   "end_s": 30.389,
   "safe_zone": true,
   "line": 7
  },
  {
   "speaker": "NARRATOR",
   "text": "B, darwaze wali.",
   "start_s": 30.409,
   "end_s": 31.955,
   "safe_zone": true,
   "line": 7
  },
  {
   "speaker": "NARRATOR",
   "text": "Kal batayenge\nasli kaun thi.",
   "start_s": 31.981,
   "end_s": 34.018,
   "safe_zone": true,
   "line": 7
  }
 ],
