 ],
 "captions": [
  {
   "speaker": "NARRATOR",
   "text": "Tumhara reflection,",
   "start_s": 0.04,
   "end_s": 1.447,
   "safe_zone": true,
   "line": 0
  },
  {
   "speaker": "NARRATOR",
   "text": "tumse thoda der se\npalak jhapkata hai?",
   "start_s": 1.467,
   "end_s": 4.207,
   "safe_zone": true,
   "line": 0
  },
  {
   "speaker": "NARRATOR",
   "text": "Aaj raat ek test karo.",
   "start_s": 4.227,
   "end_s": 6.101,
   "safe_zone": true,
   "line": 1
  },
  {
   "speaker": "NARRATOR",
   "text": "Aaine ke saamne\nkhade ho,",
   "start_s": 6.144,
   "end_s": 7.608,
   "safe_zone": true,
   "line": 1
  },
  {
   "speaker": "NARRATOR",
   "text": "aur jaldi se\npalak jhapkao.",
   "start_s": 7.628,
   "end_s": 9.44,
   "safe_zone": true,
   "line": 1
  },
  {
   "speaker": "NARRATOR",
   "text": "Agar sab normal hai,",
   "start_s": 9.46,
   "end_s": 11.094,
   "safe_zone": true,
   "line": 2
  },
  {
   "speaker": "NARRATOR",
   "text": "to wo tumhare\nsaath hi jhapkega.",
   "start_s": 11.114,
   "end_s": 13.175,
   "safe_zone": true,
   "line": 2
  },
  {
   "speaker": "NARRATOR",
   "text": "Par agar wo ek\npal bhi der se",
   "start_s": 13.195,
   "end_s": 15.191,
   "safe_zone": true,
   "line": 3
  },
  {
   "speaker": "NARRATOR",
   "text": "jhapke, to wo\ntum nahi ho.",
   "start_s": 15.211,
   "end_s": 17.491,
   "safe_zone": true,
   "line": 3
  },
  {
   "speaker": "NARRATOR",
   "text": "Neha ne ye test kiya,",
   "start_s": 17.511,
   "end_s": 19.131,
   "safe_zone": true,
   "line": 4
  },
  {
   "speaker": "NARRATOR",
   "text": "aur uska reflection\nder se jhapka.",
   "start_s": 19.151,
   "end_s": 21.433,
   "safe_zone": true,
   "line": 4
  },
  {
   "speaker": "NARRATOR",
   "text": "Phir reflection\nmuskuraya,",
   "start_s": 21.453,
   "end_s": 23.309,
   "safe_zone": true,
   "line": 5
  },
  {
   "speaker": "NARRATOR",
   "text": "par Neha to muskura\nhi nahi rahi thi.",
   "start_s": 23.456,
   "end_s": 26.007,
   "safe_zone": true,
   "line": 5
  },
  {
   "speaker": "NARRATOR",
   "text": "Ab har subah,\nwo Neha se pehle",
   "start_s": 26.427,
   "end_s": 28.725,
   "safe_zone": true,
   "line": 6
  },
  {
   "speaker": "NARRATOR",
   "text": "uth jaata hai.",
   "start_s": 28.745,
   "end_s": 29.977,
   "safe_zone": true,
   "line": 6
  },
  {
   "speaker": "NARRATOR",
   "text": "Test karke\ncomment karo,",
   "start_s": 30.047,
   "end_s": 31.494,
   "safe_zone": true,
   "line": 7
  },
  {
   "speaker": "NARRATOR",
   "text": "Normal ya Der se.",
   "start_s": 31.514,
   "end_s": 33.481,
   "safe_zone": true,
   "line": 7
  },
  {
   "speaker": "NARRATOR",
   "text": "Himmat ho to.",
   "start_s": 33.559,
   "end_s": 34.725,
   "safe_zone": true,
   "line": 7
  }
 ],
