 "captions": [
  {
   "speaker": "NARRATOR",
   "text": "Ranga pehle\ndayan nahi thi,",
   "start_s": 0.04,
   "end_s": 2.125,
   "safe_zone": true,
   "line": 0
  },
  {
   "speaker": "NARRATOR",
   "text": "wo ek dulhan thi.",
   "start_s": 2.167,
   "end_s": 3.708,
   "safe_zone": true,
   "line": 0
  },
  {
   "speaker": "NARRATOR",
   "text": "Part 1 mein\nbataya tha,",
   "start_s": 3.778,
   "end_s": 5.51,
   "safe_zone": true,
   "line": 1
  },
  {
   "speaker": "NARRATOR",
   "text": "Ranga paas ho\nto achanak bahut",
   "start_s": 5.612,
   "end_s": 7.327,
   "safe_zone": true,
   "line": 1
  },
  {
   "speaker": "NARRATOR",
   "text": "thand ho jaati hai.",
   "start_s": 7.347,
   "end_s": 8.846,
   "safe_zone": true,
   "line": 1
  },
  {
   "speaker": "NARRATOR",
   "text": "Aaj jaano kyun.",
   "start_s": 9.044,
   "end_s": 10.312,
   "safe_zone": true,
   "line": 1
  },
  {
   "speaker": "NARRATOR",
   "text": "Pahadon mein ek\nchhota sa gaon",
   "start_s": 10.333,
   "end_s": 12.101,
   "safe_zone": true,
   "line": 2
  },
  {
   "speaker": "NARRATOR",
   "text": "tha, aur sardi\nki ek raat",
   "start_s": 12.121,
   "end_s": 14.032,
   "safe_zone": true,
   "line": 2
  },
  {
   "speaker": "NARRATOR",
   "text": "Ranga ki shaadi thi.",
   "start_s": 14.052,
   "end_s": 15.783,
   "safe_zone": true,
   "line": 2
  },
  {
   "speaker": "NARRATOR",
   "text": "Wo poori raat\nsaj kar intezaar",
   "start_s": 15.803,
   "end_s": 17.763,
   "safe_zone": true,
   "line": 3
  },
  {
   "speaker": "NARRATOR",
   "text": "karti rahi, par\nbaraat aayi hi nahi.",
   "start_s": 17.783,
   "end_s": 20.63,
   "safe_zone": true,
   "line": 3
  },
  {
   "speaker": "NARRATOR",
   "text": "Gaon walon ne kaha,",
   "start_s": 20.65,
   "end_s": 22.164,
   "safe_zone": true,
   "line": 4
  },
  {
   "speaker": "NARRATOR",
   "text": "ye ladki manhoos hai.",
   "start_s": 22.184,
   "end_s": 23.832,
   "safe_zone": true,
   "line": 4
  },
  {
   "speaker": "NARRATOR",
   "text": "Unhone use barf mein bahar\nchhod diya, aur sabne apne",
   "start_s": 23.852,
   "end_s": 27.473,
   "safe_zone": true,
   "line": 5
  },
  {
   "speaker": "NARRATOR",
   "text": "darwaze band kar liye.",
   "start_s": 27.493,
   "end_s": 29.194,
   "safe_zone": true,
   "line": 5
  },
  {
   "speaker": "NARRATOR",
   "text": "Agli subah wo\nwahan nahi thi.",
   "start_s": 29.265,
   "end_s": 31.446,
   "safe_zone": true,
   "line": 6
  },
  {
   "speaker": "NARRATOR",
   "text": "Bas barf pe ek\nlambi lakeer",
   "start_s": 31.466,
   "end_s": 33.602,
   "safe_zone": true,
   "line": 7
  },
  {
   "speaker": "NARRATOR",
   "text": "thi, jo gaon\nke har ghar ke",
   "start_s": 33.622,
   "end_s": 35.689,
   "safe_zone": true,
   "line": 7
  },
  {
   "speaker": "NARRATOR",
   "text": "darwaze tak jaati thi.",
   "start_s": 35.709,
   "end_s": 37.325,
   "safe_zone": true,
   "line": 7
  },
  {
   "speaker": "NARRATOR",
   "text": "Isiliye jab\nraat ko thand",
   "start_s": 37.495,
   "end_s": 39.142,
   "safe_zone": true,
   "line": 8
  },
  {
   "speaker": "NARRATOR",
   "text": "achanak badh jaaye,",
   "start_s": 39.162,
   "end_s": 40.298,
   "safe_zone": true,
   "line": 8
  },
  {
   "speaker": "NARRATOR",
   "text": "to darwaza mat kholna.",
   "start_s": 40.318,
   "end_s": 42.323,
   "safe_zone": true,
   "line": 8
  },
  {
   "speaker": "NARRATOR",
   "text": "Kya gaon walon ko\nmaafi milni chahiye?",
   "start_s": 42.493,
   "end_s": 45.142,
   "safe_zone": true,
   "line": 9
  },
  {
   "speaker": "NARRATOR",
   "text": "Haan ya Na,\ncomment karo.",
   "start_s": 45.236,
   "end_s": 47.262,
   "safe_zone": true,
   "line": 9
  },
  {
   "speaker": "NARRATOR",
   "text": "Part 3 mein bataunga,",
   "start_s": 47.282,
   "end_s": 48.98,
   "safe_zone": true,
   "line": 10
  },
  {
   "speaker": "NARRATOR",
   "text": "Ranga se\nkaise bachein.",
   "start_s": 49.031,
   "end_s": 50.806,
   "safe_zone": true,
   "line": 10
  }
 ],
