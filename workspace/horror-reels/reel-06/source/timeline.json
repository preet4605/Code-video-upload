 "captions": [
  {
   "speaker": "NARRATOR",
   "text": "Raat ko highway\npe koi haath",
   "start_s": 0.04,
   "end_s": 1.857,
   "safe_zone": true,
   "line": 0
  },
  {
   "speaker": "NARRATOR",
   "text": "dikhaye, to\ngaadi mat rokna.",
   "start_s": 1.877,
   "end_s": 4.147,
   "safe_zone": true,
   "line": 0
  },
  {
   "speaker": "NARRATOR",
   "text": "Truck driver Pappu bhaiya ka\nek hi niyam tha, raat 12 baje",
   "start_s": 4.167,
   "end_s": 7.714,
   "safe_zone": true,
   "line": 1
  },
  {
   "speaker": "NARRATOR",
   "text": "ke baad kisi\nko lift nahi.",
   "start_s": 7.734,
   "end_s": 9.846,
   "safe_zone": true,
   "line": 1
  },
  {
   "speaker": "NARRATOR",
   "text": "Us raat sadak kinare,",
   "start_s": 10.1,
   "end_s": 11.906,
   "safe_zone": true,
   "line": 2
  },
  {
   "speaker": "NARRATOR",
   "text": "safed saree\nmein ek aurat",
   "start_s": 11.926,
   "end_s": 13.488,
   "safe_zone": true,
   "line": 2
  },
  {
   "speaker": "NARRATOR",
   "text": "haath dikha rahi thi.",
   "start_s": 13.508,
   "end_s": 15.002,
   "safe_zone": true,
   "line": 2
  },
  {
   "speaker": "NARRATOR",
   "text": "Pappu bhaiya\nnahi ruke,",
   "start_s": 15.022,
   "end_s": 16.681,
   "safe_zone": true,
   "line": 3
  },
  {
   "speaker": "NARRATOR",
   "text": "aur aage nikal gaye.",
   "start_s": 16.79,
   "end_s": 18.286,
   "safe_zone": true,
   "line": 3
  },
  {
   "speaker": "NARRATOR",
   "text": "10 kilometre baad,",
   "start_s": 18.306,
   "end_s": 19.836,
   "safe_zone": true,
   "line": 4
  },
  {
   "speaker": "NARRATOR",
   "text": "wahi aurat\nphir khadi thi,",
   "start_s": 19.856,
   "end_s": 21.699,
   "safe_zone": true,
   "line": 4
  },
  {
   "speaker": "NARRATOR",
   "text": "usi tarah haath\ndikhati hui.",
   "start_s": 21.801,
   "end_s": 23.799,
   "safe_zone": true,
   "line": 4
  },
  {
   "speaker": "NARRATOR",
   "text": "Agle 10 kilometre\nbaad bhi",
   "start_s": 23.819,
   "end_s": 25.434,
   "safe_zone": true,
   "line": 5
  },
  {
   "speaker": "NARRATOR",
   "text": "wahi thi, aur\nuske baad bhi.",
   "start_s": 25.454,
   "end_s": 27.869,
   "safe_zone": true,
   "line": 5
  },
  {
   "speaker": "NARRATOR",
   "text": "Chauthi baar wo\nsadak pe nahi thi.",
   "start_s": 27.889,
   "end_s": 30.204,
   "safe_zone": true,
   "line": 6
  },
  {
   "speaker": "NARRATOR",
   "text": "Wo side mirror mein dikh rahi\nthi, peeche wali seat pe.",
   "start_s": 30.307,
   "end_s": 33.809,
   "safe_zone": true,
   "line": 6
  },
  {
   "speaker": "NARRATOR",
   "text": "Ab batao, tum\nhote to kya karte?",
   "start_s": 34.229,
   "end_s": 36.723,
   "safe_zone": true,
   "line": 7
  },
  {
   "speaker": "NARRATOR",
   "text": "A, gaadi roko.",
   "start_s": 36.743,
   "end_s": 37.649,
   "safe_zone": true,
   "line": 8
  },
  {
   "speaker": "NARRATOR",
   "text": "B, mirror mat dekho.",
   "start_s": 37.669,
   "end_s": 38.871,
   "safe_zone": true,
   "line": 8
  },
  {
   "speaker": "NARRATOR",
   "text": "Truck walon ki\naur kahaniyan",
   "start_s": 38.891,
   "end_s": 41.229,
   "safe_zone": true,
   "line": 8
  },
  {
   "speaker": "NARRATOR",
   "text": "chahiye, to\nfollow karo.",
   "start_s": 41.249,
   "end_s": 43.26,
   "safe_zone": true,
   "line": 8
  }
 ],
