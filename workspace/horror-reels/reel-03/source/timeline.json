 "captions": [
  {
   "speaker": "NARRATOR",
   "text": "Agar lift mein\n13 ka button",
   "start_s": 0.04,
   "end_s": 1.803,
   "safe_zone": true,
   "line": 0
  },
  {
   "speaker": "NARRATOR",
   "text": "dikhe, to use\ndabaana mat.",
   "start_s": 1.823,
   "end_s": 3.968,
   "safe_zone": true,
   "line": 0
  },
  {
   "speaker": "NARRATOR",
   "text": "Hamari building\nmein 12 ke",
   "start_s": 4.038,
   "end_s": 5.677,
   "safe_zone": true,
   "line": 1
  },
  {
   "speaker": "NARRATOR",
   "text": "baad seedha\n14 aata hai,",
   "start_s": 5.697,
   "end_s": 7.68,
   "safe_zone": true,
   "line": 1
  },
  {
   "speaker": "NARRATOR",
   "text": "ye sabko pata hai.",
   "start_s": 7.703,
   "end_s": 9.093,
   "safe_zone": true,
   "line": 1
  },
  {
   "speaker": "NARRATOR",
   "text": "Ek raat,\nkareeb 1 baje,",
   "start_s": 9.113,
   "end_s": 11.678,
   "safe_zone": true,
   "line": 2
  },
  {
   "speaker": "NARRATOR",
   "text": "main lift mein\nakela tha.",
   "start_s": 11.796,
   "end_s": 13.649,
   "safe_zone": true,
   "line": 2
  },
  {
   "speaker": "NARRATOR",
   "text": "Panel pe ek\nnaya button tha,",
   "start_s": 13.669,
   "end_s": 15.693,
   "safe_zone": true,
   "line": 3
  },
  {
   "speaker": "NARRATOR",
   "text": "13, aur meri\nungli apne aap us",
   "start_s": 15.792,
   "end_s": 18.02,
   "safe_zone": true,
   "line": 3
  },
  {
   "speaker": "NARRATOR",
   "text": "pe chali gayi.",
   "start_s": 18.04,
   "end_s": 19.318,
   "safe_zone": true,
   "line": 3
  },
  {
   "speaker": "NARRATOR",
   "text": "Darwaza khula,\nto bilkul mere",
   "start_s": 19.388,
   "end_s": 21.466,
   "safe_zone": true,
   "line": 4
  },
  {
   "speaker": "NARRATOR",
   "text": "floor jaisa\ncorridor tha.",
   "start_s": 21.486,
   "end_s": 23.329,
   "safe_zone": true,
   "line": 4
  },
  {
   "speaker": "NARRATOR",
   "text": "Par wahan ke\nsaare darwaze,",
   "start_s": 23.349,
   "end_s": 25.373,
   "safe_zone": true,
   "line": 5
  },
  {
   "speaker": "NARRATOR",
   "text": "andar se zor zor se",
   "start_s": 25.393,
   "end_s": 26.573,
   "safe_zone": true,
   "line": 5
  },
  {
   "speaker": "NARRATOR",
   "text": "khatkhataye\nja rahe the.",
   "start_s": 26.593,
   "end_s": 28.441,
   "safe_zone": true,
   "line": 5
  },
  {
   "speaker": "NARRATOR",
   "text": "Main darr kar\nwapas lift mein",
   "start_s": 28.461,
   "end_s": 30.027,
   "safe_zone": true,
   "line": 6
  },
  {
   "speaker": "NARRATOR",
   "text": "bhaaga, aur seedha\napne ghar pahunch gaya.",
   "start_s": 30.047,
   "end_s": 33.14,
   "safe_zone": true,
   "line": 6
  },
  {
   "speaker": "NARRATOR",
   "text": "Tabhi Mummy\nne dheere se",
   "start_s": 33.56,
   "end_s": 34.939,
   "safe_zone": true,
   "line": 7
  },
  {
   "speaker": "NARRATOR",
   "text": "poocha, beta, tum 13\nse kab wapas aaye?",
   "start_s": 34.959,
   "end_s": 38.837,
   "safe_zone": true,
   "line": 7
  },
  {
   "speaker": "NARRATOR",
   "text": "Tumhari building\nmein 13th floor hai?",
   "start_s": 38.907,
   "end_s": 41.319,
   "safe_zone": true,
   "line": 8
  },
  {
   "speaker": "NARRATOR",
   "text": "Haan ya Nahi,\ncomment karo.",
   "start_s": 41.4,
   "end_s": 43.537,
   "safe_zone": true,
   "line": 8
  }
 ],
