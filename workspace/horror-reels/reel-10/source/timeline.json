 "captions": [
  {
   "speaker": "NARRATOR",
   "text": "Insaan teen baar\nkhatkhatata hai.",
   "start_s": 0.04,
   "end_s": 2.348,
   "safe_zone": true,
   "line": 0
  },
  {
   "speaker": "NARRATOR",
   "text": "Ye, do baar\nkhatkhatata hai.",
   "start_s": 2.403,
   "end_s": 4.722,
   "safe_zone": true,
   "line": 0
  },
  {
   "speaker": "NARRATOR",
   "text": "Raat 2 Baje\nwale ghar ka",
   "start_s": 4.792,
   "end_s": 6.27,
   "safe_zone": true,
   "line": 1
  },
  {
   "speaker": "NARRATOR",
   "text": "aakhri niyam,\ndarwaza do baar",
   "start_s": 6.29,
   "end_s": 8.694,
   "safe_zone": true,
   "line": 1
  },
  {
   "speaker": "NARRATOR",
   "text": "khatke, to mat kholna.",
   "start_s": 8.714,
   "end_s": 10.752,
   "safe_zone": true,
   "line": 1
  },
  {
   "speaker": "NARRATOR",
   "text": "Riya ne teesra\nniyam toda tha,",
   "start_s": 10.772,
   "end_s": 12.918,
   "safe_zone": true,
   "line": 2
  },
  {
   "speaker": "NARRATOR",
   "text": "aur uske baad\nhar raat 2 baje,",
   "start_s": 12.938,
   "end_s": 14.974,
   "safe_zone": true,
   "line": 2
  },
  {
   "speaker": "NARRATOR",
   "text": "do khatke aate the.",
   "start_s": 14.994,
   "end_s": 16.736,
   "safe_zone": true,
   "line": 2
  },
  {
   "speaker": "NARRATOR",
   "text": "Phir ek raat teesra\nkhatka bhi aaya.",
   "start_s": 16.756,
   "end_s": 19.305,
   "safe_zone": true,
   "line": 3
  },
  {
   "speaker": "NARRATOR",
   "text": "Riya ne socha koi insaan\nhai, aur darwaza khol diya.",
   "start_s": 19.524,
   "end_s": 23.357,
   "safe_zone": true,
   "line": 3
  },
  {
   "speaker": "NARRATOR",
   "text": "Par bahar koi\nbhi nahi tha.",
   "start_s": 23.427,
   "end_s": 25.608,
   "safe_zone": true,
   "line": 4
  },
  {
   "speaker": "NARRATOR",
   "text": "Kyunki wo\nteesra khatka,",
   "start_s": 26.077,
   "end_s": 27.886,
   "safe_zone": true,
   "line": 5
  },
  {
   "speaker": "NARRATOR",
   "text": "andar se aaya tha.",
   "start_s": 27.908,
   "end_s": 29.283,
   "safe_zone": true,
   "line": 5
  },
  {
   "speaker": "NARRATOR",
   "text": "Raat 2 Baje ka\nSeason 1 khatam.",
   "start_s": 29.353,
   "end_s": 31.917,
   "safe_zone": true,
   "line": 6
  },
  {
   "speaker": "NARRATOR",
   "text": "Season 2 mein kya ho?",
   "start_s": 32.029,
   "end_s": 33.494,
   "safe_zone": true,
   "line": 6
  },
  {
   "speaker": "NARRATOR",
   "text": "A, Riya bachti hai.",
   "start_s": 33.576,
   "end_s": 35.371,
   "safe_zone": true,
   "line": 6
  },
  {
   "speaker": "NARRATOR",
   "text": "B, ghar jeet\njaata hai.",
   "start_s": 35.432,
   "end_s": 37.512,
   "safe_zone": true,
   "line": 6
  },
  {
   "speaker": "NARRATOR",
   "text": "Follow karo,\ntaaki Season 2",
   "start_s": 37.532,
   "end_s": 39.299,
   "safe_zone": true,
   "line": 7
  },
  {
   "speaker": "NARRATOR",
   "text": "sabse pehle\ntumhe mile.",
   "start_s": 39.319,
   "end_s": 41.177,
   "safe_zone": true,
   "line": 7
  }
 ],
