 "captions": [
  {
   "speaker": "NARRATOR",
   "text": "Gaon mein kehte hain,",
   "start_s": 0.04,
   "end_s": 1.504,
   "safe_zone": true,
   "line": 0
  },
  {
   "speaker": "NARRATOR",
   "text": "peepal ke ped\nke neeche raat",
   "start_s": 1.524,
   "end_s": 3.315,
   "safe_zone": true,
   "line": 0
  },
  {
   "speaker": "NARRATOR",
   "text": "ko kabhi mat sona.",
   "start_s": 3.335,
   "end_s": 4.977,
   "safe_zone": true,
   "line": 0
  },
  {
   "speaker": "NARRATOR",
   "text": "Nanaji ke gaon\nmein ek bahut",
   "start_s": 4.997,
   "end_s": 6.753,
   "safe_zone": true,
   "line": 1
  },
  {
   "speaker": "NARRATOR",
   "text": "purana peepal tha,",
   "start_s": 6.773,
   "end_s": 8.343,
   "safe_zone": true,
   "line": 1
  },
  {
   "speaker": "NARRATOR",
   "text": "jis pe log mannat ke\ndhaage baandhte the.",
   "start_s": 8.363,
   "end_s": 11.311,
   "safe_zone": true,
   "line": 1
  },
  {
   "speaker": "NARRATOR",
   "text": "Aur uska ek\nhi niyam tha,",
   "start_s": 11.331,
   "end_s": 13.131,
   "safe_zone": true,
   "line": 2
  },
  {
   "speaker": "NARRATOR",
   "text": "raat ko uske\nneeche mat sona.",
   "start_s": 13.231,
   "end_s": 15.501,
   "safe_zone": true,
   "line": 2
  },
  {
   "speaker": "NARRATOR",
   "text": "Mera cousin\nMonu is baat pe",
   "start_s": 15.521,
   "end_s": 17.168,
   "safe_zone": true,
   "line": 3
  },
  {
   "speaker": "NARRATOR",
   "text": "hasa, aur usi raat\nwahin so gaya.",
   "start_s": 17.188,
   "end_s": 20.259,
   "safe_zone": true,
   "line": 3
  },
  {
   "speaker": "NARRATOR",
   "text": "Subah jab wo utha,",
   "start_s": 20.279,
   "end_s": 21.797,
   "safe_zone": true,
   "line": 4
  },
  {
   "speaker": "NARRATOR",
   "text": "to kuch bol\nnahi raha tha.",
   "start_s": 21.817,
   "end_s": 23.507,
   "safe_zone": true,
   "line": 4
  },
  {
   "speaker": "NARRATOR",
   "text": "Bas ek dhaage\nki taraf ektak",
   "start_s": 23.527,
   "end_s": 25.321,
   "safe_zone": true,
   "line": 5
  },
  {
   "speaker": "NARRATOR",
   "text": "dekh raha tha, ek\nkaale dhaage ki taraf.",
   "start_s": 25.341,
   "end_s": 28.855,
   "safe_zone": true,
   "line": 5
  },
  {
   "speaker": "NARRATOR",
   "text": "Us dhaage pe uska naam likha\ntha, aur ek tareekh, aaj ki.",
   "start_s": 29.275,
   "end_s": 33.831,
   "safe_zone": true,
   "line": 6
  },
  {
   "speaker": "NARRATOR",
   "text": "Tumhare gaon\nmein kaunsa ped",
   "start_s": 33.901,
   "end_s": 35.448,
   "safe_zone": true,
   "line": 7
  },
  {
   "speaker": "NARRATOR",
   "text": "hai, jiske paas raat\nko koi nahi jaata?",
   "start_s": 35.468,
   "end_s": 38.287,
   "safe_zone": true,
   "line": 7
  },
  {
   "speaker": "NARRATOR",
   "text": "Peepal, Imli ya\nBargad, comment karo.",
   "start_s": 38.428,
   "end_s": 41.553,
   "safe_zone": true,
   "line": 7
  }
 ],
