 "captions": [
  {
   "speaker": "NARRATOR",
   "text": "Wo tumhara naam do\nbaar pukaarti hai.",
   "start_s": 0.04,
   "end_s": 2.516,
   "safe_zone": true,
   "line": 0
  },
  {
   "speaker": "NARRATOR",
   "text": "Teesri baar mat sunna.",
   "start_s": 2.62,
   "end_s": 4.346,
   "safe_zone": true,
   "line": 0
  },
  {
   "speaker": "NARRATOR",
   "text": "Daadi kehti\nthi, chudail ko",
   "start_s": 4.416,
   "end_s": 6.436,
   "safe_zone": true,
   "line": 1
  },
  {
   "speaker": "NARRATOR",
   "text": "pehchanna aasaan hai,",
   "start_s": 6.456,
   "end_s": 8.048,
   "safe_zone": true,
   "line": 1
  },
  {
   "speaker": "NARRATOR",
   "text": "bas 3 cheezein\ndhyaan se dekho.",
   "start_s": 8.089,
   "end_s": 10.339,
   "safe_zone": true,
   "line": 1
  },
  {
   "speaker": "NARRATOR",
   "text": "Pehli, uske\npair ulte hote",
   "start_s": 10.359,
   "end_s": 12.35,
   "safe_zone": true,
   "line": 2
  },
  {
   "speaker": "NARRATOR",
   "text": "hain, to wo\naage chalti hai",
   "start_s": 12.37,
   "end_s": 14.58,
   "safe_zone": true,
   "line": 2
  },
  {
   "speaker": "NARRATOR",
   "text": "par nishaan peeche\nki taraf bante hain.",
   "start_s": 14.6,
   "end_s": 17.076,
   "safe_zone": true,
   "line": 2
  },
  {
   "speaker": "NARRATOR",
   "text": "Doosri, wo\ntumhari Mummy ki",
   "start_s": 17.096,
   "end_s": 19.082,
   "safe_zone": true,
   "line": 3
  },
  {
   "speaker": "NARRATOR",
   "text": "awaaz mein bulayegi,",
   "start_s": 19.102,
   "end_s": 20.467,
   "safe_zone": true,
   "line": 3
  },
  {
   "speaker": "NARRATOR",
   "text": "par do baar se zyada\nnahi bol sakti.",
   "start_s": 20.576,
   "end_s": 22.999,
   "safe_zone": true,
   "line": 3
  },
  {
   "speaker": "NARRATOR",
   "text": "Teesri, wo kabhi\nkhud andar nahi aati.",
   "start_s": 23.019,
   "end_s": 26.008,
   "safe_zone": true,
   "line": 4
  },
  {
   "speaker": "NARRATOR",
   "text": "Tum use khud\nandar bulaoge.",
   "start_s": 26.151,
   "end_s": 27.988,
   "safe_zone": true,
   "line": 4
  },
  {
   "speaker": "NARRATOR",
   "text": "Ab socho, aaj\ntumhe kisne do",
   "start_s": 28.408,
   "end_s": 30.526,
   "safe_zone": true,
   "line": 5
  },
  {
   "speaker": "NARRATOR",
   "text": "baar awaaz di thi?",
   "start_s": 30.546,
   "end_s": 31.974,
   "safe_zone": true,
   "line": 5
  },
  {
   "speaker": "NARRATOR",
   "text": "Apni daadi wala\nniyam comment",
   "start_s": 32.129,
   "end_s": 33.725,
   "safe_zone": true,
   "line": 6
  },
  {
   "speaker": "NARRATOR",
   "text": "karo, sabse achha\nwala agli reel banega.",
   "start_s": 33.745,
   "end_s": 37.077,
   "safe_zone": true,
   "line": 6
  }
 ],
