 "captions": [
  {
   "speaker": "NARRATOR",
   "text": "Kisi ne teesra\nniyam tod diya.",
   "start_s": 0.04,
   "end_s": 2.308,
   "safe_zone": true,
   "line": 0
  },
  {
   "speaker": "NARRATOR",
   "text": "Part 2 mein\nbataya tha,",
   "start_s": 2.428,
   "end_s": 4.198,
   "safe_zone": true,
   "line": 1
  },
  {
   "speaker": "NARRATOR",
   "text": "agar raat ko\nchhat se awaaz",
   "start_s": 4.218,
   "end_s": 5.809,
   "safe_zone": true,
   "line": 1
  },
  {
   "speaker": "NARRATOR",
   "text": "aaye, to bistar\nmat chhodna.",
   "start_s": 5.829,
   "end_s": 7.902,
   "safe_zone": true,
   "line": 1
  },
  {
   "speaker": "NARRATOR",
   "text": "Par Riya ne ye\nniyam nahi maana.",
   "start_s": 7.922,
   "end_s": 10.248,
   "safe_zone": true,
   "line": 2
  },
  {
   "speaker": "NARRATOR",
   "text": "Raat ke 2 baj\nkar 3 minute pe,",
   "start_s": 10.268,
   "end_s": 12.739,
   "safe_zone": true,
   "line": 3
  },
  {
   "speaker": "NARRATOR",
   "text": "upar daudne ki awaaz\nachanak ruk gayi.",
   "start_s": 12.759,
   "end_s": 15.436,
   "safe_zone": true,
   "line": 3
  },
  {
   "speaker": "NARRATOR",
   "text": "Riya uthi, aur\ndheere dheere",
   "start_s": 15.456,
   "end_s": 17.66,
   "safe_zone": true,
   "line": 4
  },
  {
   "speaker": "NARRATOR",
   "text": "seedhiyon tak gayi.",
   "start_s": 17.68,
   "end_s": 18.982,
   "safe_zone": true,
   "line": 4
  },
  {
   "speaker": "NARRATOR",
   "text": "Chhat ka darwaza,\njo har raat",
   "start_s": 19.002,
   "end_s": 21.049,
   "safe_zone": true,
   "line": 5
  },
  {
   "speaker": "NARRATOR",
   "text": "band rehta tha,\naaj khula hua tha.",
   "start_s": 21.069,
   "end_s": 23.899,
   "safe_zone": true,
   "line": 5
  },
  {
   "speaker": "NARRATOR",
   "text": "Chhat pe koi nahi tha,",
   "start_s": 23.919,
   "end_s": 25.637,
   "safe_zone": true,
   "line": 6
  },
  {
   "speaker": "NARRATOR",
   "text": "bas zameen pe geele\npairon ke nishaan the.",
   "start_s": 25.666,
   "end_s": 28.563,
   "safe_zone": true,
   "line": 6
  },
  {
   "speaker": "NARRATOR",
   "text": "Nange pair, aur\nunki ungliyan",
   "start_s": 28.583,
   "end_s": 30.605,
   "safe_zone": true,
   "line": 7
  },
  {
   "speaker": "NARRATOR",
   "text": "peeche ki taraf thi,",
   "start_s": 30.625,
   "end_s": 32.078,
   "safe_zone": true,
   "line": 7
  },
  {
   "speaker": "NARRATOR",
   "text": "yaani pair ulte the.",
   "start_s": 32.098,
   "end_s": 33.751,
   "safe_zone": true,
   "line": 7
  },
  {
   "speaker": "NARRATOR",
   "text": "Riya darr ke maare bhaag kar\nneeche apne kamre mein aayi.",
   "start_s": 33.771,
   "end_s": 36.923,
   "safe_zone": true,
   "line": 8
  },
  {
   "speaker": "NARRATOR",
   "text": "Par uske bistar\npe koi pehle",
   "start_s": 36.943,
   "end_s": 38.638,
   "safe_zone": true,
   "line": 9
  },
  {
   "speaker": "NARRATOR",
   "text": "se so raha tha,\nbilkul usi ke",
   "start_s": 38.658,
   "end_s": 40.844,
   "safe_zone": true,
   "line": 9
  },
  {
   "speaker": "NARRATOR",
   "text": "jaise kapde pehen kar.",
   "start_s": 40.864,
   "end_s": 42.464,
   "safe_zone": true,
   "line": 9
  },
  {
   "speaker": "NARRATOR",
   "text": "Ab batao, neeche\nbistar pe kaun hai?",
   "start_s": 42.884,
   "end_s": 45.566,
   "safe_zone": true,
   "line": 10
  },
  {
   "speaker": "NARRATOR",
   "text": "A ya B, comment karo.",
   "start_s": 45.586,
   "end_s": 47.526,
   "safe_zone": true,
   "line": 11
  },
  {
   "speaker": "NARRATOR",
   "text": "Part 4 mein\njawab milega.",
   "start_s": 47.605,
   "end_s": 49.507,
   "safe_zone": true,
   "line": 11
  }
 ],
