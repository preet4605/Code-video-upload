 "captions": [
  {
   "speaker": "NARRATOR",
   "text": "Kamre mein\n28 ladke the,",
   "start_s": 0.04,
   "end_s": 2.084,
   "safe_zone": true,
   "line": 0
  },
  {
   "speaker": "NARRATOR",
   "text": "lekin ginti aayi 29.",
   "start_s": 2.149,
   "end_s": 4.618,
   "safe_zone": true,
   "line": 0
  },
  {
   "speaker": "NARRATOR",
   "text": "Hamare hostel\nmein har raat",
   "start_s": 4.638,
   "end_s": 6.273,
   "safe_zone": true,
   "line": 1
  },
  {
   "speaker": "NARRATOR",
   "text": "ginti hoti thi,\nwarden har bed",
   "start_s": 6.293,
   "end_s": 8.492,
   "safe_zone": true,
   "line": 1
  },
  {
   "speaker": "NARRATOR",
   "text": "pe torch maarta tha.",
   "start_s": 8.512,
   "end_s": 10.042,
   "safe_zone": true,
   "line": 1
  },
  {
   "speaker": "NARRATOR",
   "text": "28 ladke the,\naur har raat",
   "start_s": 10.062,
   "end_s": 12.508,
   "safe_zone": true,
   "line": 2
  },
  {
   "speaker": "NARRATOR",
   "text": "ginti 28 hi aati thi.",
   "start_s": 12.528,
   "end_s": 14.518,
   "safe_zone": true,
   "line": 2
  },
  {
   "speaker": "NARRATOR",
   "text": "Ek raat warden\nne gina,",
   "start_s": 14.538,
   "end_s": 16.297,
   "safe_zone": true,
   "line": 3
  },
  {
   "speaker": "NARRATOR",
   "text": "to 29 nikle.",
   "start_s": 16.317,
   "end_s": 17.644,
   "safe_zone": true,
   "line": 3
  },
  {
   "speaker": "NARRATOR",
   "text": "Usne ghabra kar\ndobara gina,",
   "start_s": 17.664,
   "end_s": 19.585,
   "safe_zone": true,
   "line": 4
  },
  {
   "speaker": "NARRATOR",
   "text": "phir se 29.",
   "start_s": 19.605,
   "end_s": 20.879,
   "safe_zone": true,
   "line": 4
  },
  {
   "speaker": "NARRATOR",
   "text": "Kone wala bed,\njo saalon se",
   "start_s": 20.9,
   "end_s": 22.976,
   "safe_zone": true,
   "line": 5
  },
  {
   "speaker": "NARRATOR",
   "text": "khaali tha, us\npe chadar uthi",
   "start_s": 22.996,
   "end_s": 24.996,
   "safe_zone": true,
   "line": 5
  },
  {
   "speaker": "NARRATOR",
   "text": "hui thi, jaise\nkoi so raha ho.",
   "start_s": 25.016,
   "end_s": 27.803,
   "safe_zone": true,
   "line": 5
  },
  {
   "speaker": "NARRATOR",
   "text": "Subah wo bed\nphir khaali tha.",
   "start_s": 28.223,
   "end_s": 30.31,
   "safe_zone": true,
   "line": 6
  },
  {
   "speaker": "NARRATOR",
   "text": "Par mera bed, ab\nkone mein tha.",
   "start_s": 30.35,
   "end_s": 32.873,
   "safe_zone": true,
   "line": 6
  },
  {
   "speaker": "NARRATOR",
   "text": "Apne hostel\nka naam likho,",
   "start_s": 32.943,
   "end_s": 34.728,
   "safe_zone": true,
   "line": 7
  },
  {
   "speaker": "NARRATOR",
   "text": "agli reel\nwahin ki hogi.",
   "start_s": 34.796,
   "end_s": 36.651,
   "safe_zone": true,
   "line": 7
  }
 ],
