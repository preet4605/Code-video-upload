 "lines": [
  {
   "i": 0,
   "speaker": "NARRATOR",
   "text": "शादी से एक रात पहले, सीढ़ियों पर मेरे पीछे कोई चल रहा था।",
   "start_s": 0.1,
   "end_s": 3.6
  },
  {
   "i": 1,
   "speaker": "NARRATOR",
   "text": "दादी कहती थीं, पहली दुल्हन की चूड़ियाँ बजें, तो मुड़कर मत देखना।",
   "start_s": 3.8,
   "end_s": 8.2
  },
  {
   "i": 2,
   "speaker": "NARRATOR",
   "text": "गीले पैरों के निशान मुझसे आगे चढ़ रहे थे।",
   "start_s": 8.5,
   "end_s": 11.6
  },
  {
   "i": 3,
   "speaker": "NARRATOR",
   "text": "हर क़दम पर पीछे चूड़ियाँ छनक रही थीं।",
   "start_s": 11.9,
   "end_s": 14.4
  },
  {
   "i": 4,
   "speaker": "NARRATOR",
   "text": "बत्ती बुझती, और चूड़ियाँ एक क़दम पास आ जातीं।",
   "start_s": 14.7,
   "end_s": 18
  },
  {
   "i": 5,
   "speaker": "NARRATOR",
   "text": "ऊपर कोई खड़ा था, पीठ मेरी तरफ़, पानी टपकता हुआ।",
   "start_s": 18.3,
   "end_s": 21.9
  },
  {
   "i": 6,
   "speaker": "NARRATOR",
   "text": "मैंने मुड़कर देख लिया।",
   "start_s": 23.9,
   "end_s": 25.3
  },
  {
   "i": 7,
   "speaker": "NARRATOR",
   "text": "पीछे बस एक परछाईं थी, और छनकती चूड़ियाँ।",
   "start_s": 25.5,
   "end_s": 28
  },
  {
   "i": 8,
   "speaker": "NARRATOR",
   "text": "देखते ही वो चली गईं। वो मुझे घर छोड़ने आई थीं, गीले साये से बचाकर।",
   "start_s": 28.1,
   "end_s": 32
  },
  {
   "i": 9,
   "speaker": "NARRATOR",
   "text": "टूटी चूड़ियाँ उठाईं और भागा।",
   "start_s": 32.2,
   "end_s": 35.4
  },
  {
   "i": 10,
   "speaker": "NARRATOR",
   "text": "अब सीढ़ियों पर मेरे पीछे कोई नहीं चलता।",
   "start_s": 36,
   "end_s": 38.6
  },
  {
   "i": 11,
   "speaker": "NARRATOR",
   "text": "वो दरवाज़े के बाहर खड़ा रहता है।",
   "start_s": 38.8,
   "end_s": 42.3
  }
 ],
