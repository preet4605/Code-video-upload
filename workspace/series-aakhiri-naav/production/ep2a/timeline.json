 "captions": [
  {
   "speaker": "NARRATOR",
   "text": "मैं पानी में उतरा, तो\nलगा किसी ने मेरी छाती पर",
   "start_s": 0.02,
   "end_s": 3.383,
   "safe_zone": true,
   "line": 0
  },
  {
   "speaker": "NARRATOR",
   "text": "हाथ रख दिया।",
   "start_s": 3.403,
   "end_s": 4.741,
   "safe_zone": true,
   "line": 0
  },
  {
   "speaker": "NARRATOR",
   "text": "साँस तेज़ हुई, पर\nहवा खींचता तो डूबता,",
   "start_s": 4.811,
   "end_s": 8.937,
   "safe_zone": true,
   "line": 1
  },
  {
   "speaker": "NARRATOR",
   "text": "इसलिए धीरे-धीरे साँस लेता रहा।",
   "start_s": 9.081,
   "end_s": 11.676,
   "safe_zone": true,
   "line": 1
  },
  {
   "speaker": "NARRATOR",
   "text": "तीन रात से मैं किनारे\nसे पुकार रहा था,",
   "start_s": 11.696,
   "end_s": 14.635,
   "safe_zone": true,
   "line": 2
  },
  {
   "speaker": "NARRATOR",
   "text": "छोटे, मैं यहीं हूँ, और\nआज शाम पाँच बजे नाव",
   "start_s": 14.859,
   "end_s": 19.563,
   "safe_zone": true,
   "line": 2
  },
  {
   "speaker": "NARRATOR",
   "text": "उसकी जैकेट लेकर लौटी थी।",
   "start_s": 19.583,
   "end_s": 21.612,
   "safe_zone": true,
   "line": 2
  },
  {
   "speaker": "NARRATOR",
   "text": "पानी गर्म हो गया,\nकंपकंपी थम गई,",
   "start_s": 21.632,
   "end_s": 24.799,
   "safe_zone": true,
   "line": 3
  },
  {
   "speaker": "NARRATOR",
   "text": "और मुझे अच्छा लगा, जो दिसंबर\nकी झील में हो ही नहीं सकता।",
   "start_s": 24.874,
   "end_s": 29.022,
   "safe_zone": true,
   "line": 3
  },
  {
   "speaker": "NARRATOR",
   "text": "केबिन के पीछे भनभनाहट थी,",
   "start_s": 29.042,
   "end_s": 31.415,
   "safe_zone": true,
   "line": 4
  },
  {
   "speaker": "NARRATOR",
   "text": "पास जाकर समझ आया कि\nवह बहुत सारे लोगों का",
   "start_s": 31.716,
   "end_s": 34.811,
   "safe_zone": true,
   "line": 4
  },
  {
   "speaker": "NARRATOR",
   "text": "एक ही शब्द है, हाँ, हाँ, हाँ।",
   "start_s": 34.831,
   "end_s": 37.955,
   "safe_zone": true,
   "line": 4
  },
  {
   "speaker": "NARRATOR",
   "text": "सीट की लाल जैकेट गर्म\nथी, और उसमें नारियल",
   "start_s": 37.975,
   "end_s": 41.367,
   "safe_zone": true,
   "line": 5
  },
  {
   "speaker": "NARRATOR",
   "text": "के तेल की वही महक थी जो\nभाई के बालों में रहती थी।",
   "start_s": 41.387,
   "end_s": 45.129,
   "safe_zone": true,
   "line": 5
  },
  {
   "speaker": "NARRATOR",
   "text": "मुझे लगा कि वह ज़िंदा\nहै, और मैं रो पड़ा।",
   "start_s": 45.149,
   "end_s": 48.84,
   "safe_zone": true,
   "line": 6
  },
  {
   "speaker": "CHARACTER",
   "text": "इधर आ जा, बहुत ठंड है,",
   "start_s": 49.51,
   "end_s": 52.104,
   "safe_zone": true,
   "line": 7
  },
  {
   "speaker": "CHARACTER",
   "text": "चल घर चलें।",
   "start_s": 52.124,
   "end_s": 54.232,
   "safe_zone": true,
   "line": 7
  },
  {
   "speaker": "NARRATOR",
   "text": "नाव ने मेरा पूरा नाम\nलिया, जो सिर्फ़ माँ लेती थीं,",
   "start_s": 54.66,
   "end_s": 58.808,
   "safe_zone": true,
   "line": 8
  },
  {
   "speaker": "NARRATOR",
   "text": "और आवाज़ इतनी नरम\nथी कि मैं पहचान गया।",
   "start_s": 58.949,
   "end_s": 63.033,
   "safe_zone": true,
   "line": 8
  },
  {
   "speaker": "NARRATOR",
   "text": "गाँव वाले कहते हैं, जवाब मत दो,",
   "start_s": 63.054,
   "end_s": 65.771,
   "safe_zone": true,
   "line": 9
  },
  {
   "speaker": "NARRATOR",
   "text": "पर नाम सुनकर जवाब\nदेना सबसे पुरानी आदत",
   "start_s": 65.967,
   "end_s": 68.978,
   "safe_zone": true,
   "line": 9
  },
  {
   "speaker": "NARRATOR",
   "text": "है, और मैं हार गया।",
   "start_s": 68.998,
   "end_s": 70.845,
   "safe_zone": true,
   "line": 9
  },
  {
   "speaker": "NARRATOR",
   "text": "हाँ, मैं यहीं हूँ।",
   "start_s": 70.865,
   "end_s": 73.029,
   "safe_zone": true,
   "line": 10
  },
  {
   "speaker": "NARRATOR",
   "text": "बत्ती बुझ गई, और\nपानी ने मेरी छाती को उसी",
   "start_s": 73.549,
   "end_s": 76.961,
   "safe_zone": true,
   "line": 11
  },
  {
   "speaker": "NARRATOR",
   "text": "हाथ की तरह जकड़ लिया।",
   "start_s": 76.981,
   "end_s": 78.752,
   "safe_zone": true,
   "line": 11
  },
  {
   "speaker": "NARRATOR",
   "text": "तभी पीछे से एक छोटे\nहाथ ने मुझे किनारे की",
   "start_s": 78.772,
   "end_s": 82.122,
   "safe_zone": true,
   "line": 12
  },
  {
   "speaker": "NARRATOR",
   "text": "तरफ़ धकेल दिया।",
   "start_s": 82.142,
   "end_s": 83.646,
   "safe_zone": true,
   "line": 12
  }
 ],
