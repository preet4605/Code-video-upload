 "lines": [
  {
   "i": 0,
   "speaker": "NARRATOR",
   "text": "मैं पानी में उतरा, तो लगा किसी ने मेरी छाती पर हाथ रख दिया।",
   "start_s": 0.1,
   "end_s": 4.391
  },
  {
   "i": 1,
   "speaker": "NARRATOR",
   "text": "साँस तेज़ हुई, पर हवा खींचता तो डूबता, इसलिए धीरे-धीरे साँस लेता रहा।",
   "start_s": 4.891,
   "end_s": 11.446
  },
  {
   "i": 2,
   "speaker": "NARRATOR",
   "text": "तीन रात से मैं किनारे से पुकार रहा था, छोटे, मैं यहीं हूँ, और आज शाम पाँच बजे नाव उसकी जैकेट लेकर लौटी थी।",
   "start_s": 11.776,
   "end_s": 21.382
  },
  {
   "i": 3,
   "speaker": "NARRATOR",
   "text": "पानी गर्म हो गया, कंपकंपी थम गई, और मुझे अच्छा लगा, जो दिसंबर की झील में हो ही नहीं सकता।",
   "start_s": 21.712,
   "end_s": 28.792
  },
  {
   "i": 4,
   "speaker": "NARRATOR",
   "text": "केबिन के पीछे भनभनाहट थी, पास जाकर समझ आया कि वह बहुत सारे लोगों का एक ही शब्द है, हाँ, हाँ, हाँ।",
   "start_s": 29.122,
   "end_s": 37.725
  },
  {
   "i": 5,
   "speaker": "NARRATOR",
   "text": "सीट की लाल जैकेट गर्म थी, और उसमें नारियल के तेल की वही महक थी जो भाई के बालों में रहती थी।",
   "start_s": 38.055,
   "end_s": 44.899
  },
  {
   "i": 6,
   "speaker": "NARRATOR",
   "text": "मुझे लगा कि वह ज़िंदा है, और मैं रो पड़ा।",
   "start_s": 45.229,
   "end_s": 48.49
  },
  {
   "i": 7,
   "speaker": "CHARACTER",
   "text": "इधर आ जा, बहुत ठंड है, चल घर चलें।",
   "start_s": 49.59,
   "end_s": 54.19
  },
  {
   "i": 8,
   "speaker": "NARRATOR",
   "text": "नाव ने मेरा पूरा नाम लिया, जो सिर्फ़ माँ लेती थीं, और आवाज़ इतनी नरम थी कि मैं पहचान गया।",
   "start_s": 54.74,
   "end_s": 62.684
  },
  {
   "i": 9,
   "speaker": "NARRATOR",
   "text": "गाँव वाले कहते हैं, जवाब मत दो, पर नाम सुनकर जवाब देना सबसे पुरानी आदत है, और मैं हार गया।",
   "start_s": 63.134,
   "end_s": 70.645
  },
  {
   "i": 10,
   "speaker": "NARRATOR",
   "text": "हाँ, मैं यहीं हूँ।",
   "start_s": 70.945,
   "end_s": 72.679
  },
  {
   "i": 11,
   "speaker": "NARRATOR",
   "text": "बत्ती बुझ गई, और पानी ने मेरी छाती को उसी हाथ की तरह जकड़ लिया।",
   "start_s": 73.629,
   "end_s": 78.502
  },
  {
   "i": 12,
   "speaker": "NARRATOR",
   "text": "तभी पीछे से एक छोटे हाथ ने मुझे किनारे की तरफ़ धकेल दिया।",
   "start_s": 78.852,
   "end_s": 83.297
  }
 ],
