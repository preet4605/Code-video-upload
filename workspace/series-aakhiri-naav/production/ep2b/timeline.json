 "captions": [
  {
   "speaker": "NARRATOR",
   "text": "मैं किनारे पर रुका रहा,\nऔर पानी के पार से",
   "start_s": 0.02,
   "end_s": 3.206,
   "safe_zone": true,
   "line": 0
  },
  {
   "speaker": "NARRATOR",
   "text": "कोई चलकर आने लगा।",
   "start_s": 3.226,
   "end_s": 4.978,
   "safe_zone": true,
   "line": 0
  },
  {
   "speaker": "NARRATOR",
   "text": "तीन रात से मैं यहाँ\nखड़ा पुकारता रहा,",
   "start_s": 5.048,
   "end_s": 8.12,
   "safe_zone": true,
   "line": 1
  },
  {
   "speaker": "NARRATOR",
   "text": "छोटे, मैं यहीं हूँ, और\nआज शाम पाँच बजे पहली",
   "start_s": 8.3,
   "end_s": 13.07,
   "safe_zone": true,
   "line": 1
  },
  {
   "speaker": "NARRATOR",
   "text": "बार किसी ने जवाब दिया।",
   "start_s": 13.09,
   "end_s": 14.917,
   "safe_zone": true,
   "line": 1
  },
  {
   "speaker": "NARRATOR",
   "text": "उसके पैरों पर कोई\nलहर नहीं उठती थी,",
   "start_s": 14.937,
   "end_s": 17.807,
   "safe_zone": true,
   "line": 2
  },
  {
   "speaker": "NARRATOR",
   "text": "और वह हर क़दम\nबाईं तरफ़ झुकाकर रखता",
   "start_s": 18.02,
   "end_s": 20.88,
   "safe_zone": true,
   "line": 2
  },
  {
   "speaker": "NARRATOR",
   "text": "था, मेरे छोटे भाई की तरह।",
   "start_s": 20.9,
   "end_s": 23.673,
   "safe_zone": true,
   "line": 2
  },
  {
   "speaker": "CHARACTER",
   "text": "तू सुन रहा है न?",
   "start_s": 23.693,
   "end_s": 25.267,
   "safe_zone": true,
   "line": 3
  },
  {
   "speaker": "CHARACTER",
   "text": "घर चल, बस एक बार बोल दे।",
   "start_s": 25.287,
   "end_s": 28.638,
   "safe_zone": true,
   "line": 3
  },
  {
   "speaker": "NARRATOR",
   "text": "मेरा पूरा नाम पानी से\nआया, मैंने दाँत भींच लिए,",
   "start_s": 29.096,
   "end_s": 33.008,
   "safe_zone": true,
   "line": 4
  },
  {
   "speaker": "NARRATOR",
   "text": "क्योंकि गाँव वाले कहते हैं, नाव\nकी आवाज़ का जवाब मत दो।",
   "start_s": 33.028,
   "end_s": 37.576,
   "safe_zone": true,
   "line": 4
  },
  {
   "speaker": "NARRATOR",
   "text": "वह नाव की बत्ती में आया,\nऔर मैं समझ गया कि",
   "start_s": 37.596,
   "end_s": 41.088,
   "safe_zone": true,
   "line": 5
  },
  {
   "speaker": "NARRATOR",
   "text": "वह पानी के नीचे चल रहा है,",
   "start_s": 41.108,
   "end_s": 43.178,
   "safe_zone": true,
   "line": 5
  },
  {
   "speaker": "NARRATOR",
   "text": "उल्टा, सिर गहराई में लटका हुआ।",
   "start_s": 43.388,
   "end_s": 46.092,
   "safe_zone": true,
   "line": 5
  },
  {
   "speaker": "NARRATOR",
   "text": "वह मेरे पाँवों तक पहुँचा,\nऔर सतह के नीचे से",
   "start_s": 46.112,
   "end_s": 49.527,
   "safe_zone": true,
   "line": 6
  },
  {
   "speaker": "NARRATOR",
   "text": "एक सफ़ेद चेहरा मुझे देखने लगा,",
   "start_s": 49.547,
   "end_s": 52.261,
   "safe_zone": true,
   "line": 6
  },
  {
   "speaker": "NARRATOR",
   "text": "होंठ हिलते थे, आवाज़\nकहीं और से आती थी।",
   "start_s": 52.476,
   "end_s": 56.398,
   "safe_zone": true,
   "line": 6
  },
  {
   "speaker": "NARRATOR",
   "text": "मैं बिना हिले खड़ा रहा,\nचेहरा लहरों में घुल",
   "start_s": 56.418,
   "end_s": 59.559,
   "safe_zone": true,
   "line": 7
  },
  {
   "speaker": "NARRATOR",
   "text": "गया, आवाज़ बंद हो गई,\nऔर मुझे लगा कि मैं जीत गया।",
   "start_s": 59.579,
   "end_s": 64.456,
   "safe_zone": true,
   "line": 7
  },
  {
   "speaker": "CHARACTER",
   "text": "हाँ, मैं यहीं हूँ।",
   "start_s": 65.126,
   "end_s": 67.98,
   "safe_zone": true,
   "line": 8
  },
  {
   "speaker": "NARRATOR",
   "text": "मैंने एक शब्द नहीं कहा\nथा, पर झील से मेरी",
   "start_s": 68.307,
   "end_s": 72.132,
   "safe_zone": true,
   "line": 9
  },
  {
   "speaker": "NARRATOR",
   "text": "अपनी आवाज़ ने जवाब दे दिया।",
   "start_s": 72.152,
   "end_s": 74.475,
   "safe_zone": true,
   "line": 9
  },
  {
   "speaker": "NARRATOR",
   "text": "फिर बिना हवा के एक लहर चढ़ी,",
   "start_s": 74.495,
   "end_s": 77.078,
   "safe_zone": true,
   "line": 10
  },
  {
   "speaker": "NARRATOR",
   "text": "मुझे छाती तक भिगोकर धकेल गई,",
   "start_s": 77.098,
   "end_s": 79.36,
   "safe_zone": true,
   "line": 10
  },
  {
   "speaker": "NARRATOR",
   "text": "जैसे बहुत सारे छोटे हाथ\nमुझे बाहर धकेल रहे हों।",
   "start_s": 79.38,
   "end_s": 82.937,
   "safe_zone": true,
   "line": 10
  },
  {
   "speaker": "NARRATOR",
   "text": "झील के पास अब मेरी आवाज़ थी,",
   "start_s": 82.957,
   "end_s": 85.65,
   "safe_zone": true,
   "line": 11
  },
  {
   "speaker": "NARRATOR",
   "text": "और वह किसे बुलाएगी?",
   "start_s": 85.883,
   "end_s": 87.468,
   "safe_zone": true,
   "line": 11
  }
 ],
