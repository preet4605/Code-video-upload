 ],
 "captions": [
  {
   "speaker": "NARRATOR",
   "text": "Raat ki train mein,",
   "start_s": 0.07,
   "end_s": 1.531,
   "safe_zone": true,
   "line": 0
  },
  {
   "speaker": "NARRATOR",
   "text": "saamne wale\nuncle bole,",
   "start_s": 1.551,
   "end_s": 3.354,
   "safe_zone": true,
   "line": 0
  },
  {
   "speaker": "NARRATOR",
   "text": "beta, Itarsi aaye\ntoh utha dena.",
   "start_s": 3.521,
   "end_s": 6.571,
   "safe_zone": true,
   "line": 0
  },
  {
   "speaker": "NARRATOR",
   "text": "Baarah saal se\nnahi uth paaya.",
   "start_s": 6.591,
   "end_s": 8.779,
   "safe_zone": true,
   "line": 1
  },
  {
   "speaker": "NARRATOR",
   "text": "Main hans diya.",
   "start_s": 8.949,
   "end_s": 10.295,
   "safe_zone": true,
   "line": 2
  },
  {
   "speaker": "NARRATOR",
   "text": "Mujhe Bhopal\nutarna tha.",
   "start_s": 10.4,
   "end_s": 12.244,
   "safe_zone": true,
   "line": 2
  },
  {
   "speaker": "NARRATOR",
   "text": "Sab so rahe the.",
   "start_s": 12.297,
   "end_s": 13.805,
   "safe_zone": true,
   "line": 2
  },
  {
   "speaker": "NARRATOR",
   "text": "Unke haath mein kaagaz\nwala ticket tha.",
   "start_s": 13.825,
   "end_s": 16.355,
   "safe_zone": true,
   "line": 3
  },
  {
   "speaker": "NARRATOR",
   "text": "Tareekh, chaudah June,",
   "start_s": 16.375,
   "end_s": 18.458,
   "safe_zone": true,
   "line": 4
  },
  {
   "speaker": "NARRATOR",
   "text": "do hazaar chaudah.",
   "start_s": 18.478,
   "end_s": 20.029,
   "safe_zone": true,
   "line": 4
  },
  {
   "speaker": "NARRATOR",
   "text": "Uncle bole, apna\nstation sote",
   "start_s": 20.199,
   "end_s": 22.441,
   "safe_zone": true,
   "line": 5
  },
  {
   "speaker": "NARRATOR",
   "text": "hue mat nikaalna.",
   "start_s": 22.461,
   "end_s": 23.858,
   "safe_zone": true,
   "line": 5
  },
  {
   "speaker": "NARRATOR",
   "text": "Kehte hain,\njo nikaal de,",
   "start_s": 23.937,
   "end_s": 25.586,
   "safe_zone": true,
   "line": 5
  },
  {
   "speaker": "NARRATOR",
   "text": "woh is dibbe\nse nahi utarta.",
   "start_s": 25.606,
   "end_s": 28.008,
   "safe_zone": true,
   "line": 5
  },
  {
   "speaker": "NARRATOR",
   "text": "Raat do baje,\ntrain aisi jagah",
   "start_s": 28.178,
   "end_s": 30.908,
   "safe_zone": true,
   "line": 6
  },
  {
   "speaker": "NARRATOR",
   "text": "ruki jahan koi\nstation nahi tha.",
   "start_s": 30.928,
   "end_s": 33.444,
   "safe_zone": true,
   "line": 6
  },
  {
   "speaker": "NARRATOR",
   "text": "Uncle ki chhaati\nhil nahi rahi thi.",
   "start_s": 33.514,
   "end_s": 35.919,
   "safe_zone": true,
   "line": 7
  },
  {
   "speaker": "NARRATOR",
   "text": "Par unki aankhein\nmere saath",
   "start_s": 36.108,
   "end_s": 37.918,
   "safe_zone": true,
   "line": 7
  },
  {
   "speaker": "NARRATOR",
   "text": "ghoom rahi thi.",
   "start_s": 37.938,
   "end_s": 39.241,
   "safe_zone": true,
   "line": 7
  },
  {
   "speaker": "NARRATOR",
   "text": "Har berth pe\nlog lete the.",
   "start_s": 39.311,
   "end_s": 41.475,
   "safe_zone": true,
   "line": 8
  },
  {
   "speaker": "NARRATOR",
   "text": "Sabke haath mein\nwahi purana ticket.",
   "start_s": 41.565,
   "end_s": 44.275,
   "safe_zone": true,
   "line": 8
  },
  {
   "speaker": "NARRATOR",
   "text": "Phir Itarsi aaya.",
   "start_s": 44.446,
   "end_s": 45.983,
   "safe_zone": true,
   "line": 9
  },
  {
   "speaker": "NARRATOR",
   "text": "Maine uncle\nko hilaaya.",
   "start_s": 46.176,
   "end_s": 47.795,
   "safe_zone": true,
   "line": 9
  },
  {
   "speaker": "NARRATOR",
   "text": "Woh muskuraaye,\naur utar gaye.",
   "start_s": 47.855,
   "end_s": 50.239,
   "safe_zone": true,
   "line": 9
  },
  {
   "speaker": "NARRATOR",
   "text": "Maine bas ek\npal ke liye",
   "start_s": 50.308,
   "end_s": 52.294,
   "safe_zone": true,
   "line": 10
  },
  {
   "speaker": "NARRATOR",
   "text": "aankhein band ki.",
   "start_s": 52.314,
   "end_s": 53.665,
   "safe_zone": true,
   "line": 10
  },
  {
   "speaker": "NARRATOR",
   "text": "Aankh khuli,\ntoh khidki se",
   "start_s": 54.236,
   "end_s": 56.208,
   "safe_zone": true,
   "line": 11
  },
  {
   "speaker": "NARRATOR",
   "text": "Bhopal peeche\nchhoot raha tha.",
   "start_s": 56.228,
   "end_s": 58.343,
   "safe_zone": true,
   "line": 11
  },
  {
   "speaker": "NARRATOR",
   "text": "Mera ticket ab\npeela pad chuka hai.",
   "start_s": 58.512,
   "end_s": 61.464,
   "safe_zone": true,
   "line": 12
  },
  {
   "speaker": "NARRATOR",
   "text": "Saamne wali berth\npe ek ladka hai.",
   "start_s": 61.734,
   "end_s": 64.178,
   "safe_zone": true,
   "line": 13
  },
  {
   "speaker": "NARRATOR",
   "text": "Beta, Bhopal aaye\ntoh utha dena.",
