{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "CodeVideoStudioTimeline",
  "type": "object",
  "required": ["version", "slug", "aspect", "width", "height", "fps", "duration_s", "scenes"],
  "properties": {
    "version": { "type": "string", "const": "1.0" },
    "slug": { "type": "string", "minLength": 1 },
    "aspect": { "type": "string", "enum": ["9:16", "16:9", "1:1"] },
    "width": { "type": "integer", "minimum": 128 },
    "height": { "type": "integer", "minimum": 128 },
    "fps": { "type": "integer", "enum": [15, 24, 30, 60] },
    "duration_s": { "type": "number", "exclusiveMinimum": 0 },
    "target_lufs": { "type": "number", "default": -16 },
    "true_peak_dbtp": { "type": "number", "maximum": -1.0, "default": -1.5 },
    "audio_file": { "type": ["string", "null"] },
    "scenes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "start_s", "end_s", "beats"],
        "properties": {
          "id": { "type": "string" },
          "start_s": { "type": "number", "minimum": 0 },
          "end_s": { "type": "number", "exclusiveMinimum": 0 },
          "mood": { "type": "string", "enum": ["neutral", "energetic", "suspense", "climax", "calm"] },
          "ambient_motion": { "type": "boolean", "default": false },
          "beats": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": ["t_s", "dur_s", "animated_properties"],
              "properties": {
                "t_s": { "type": "number", "minimum": 0 },
                "dur_s": { "type": "number", "exclusiveMinimum": 0 },
                "hold": { "type": "boolean", "default": false },
                "flashes_per_sec": { "type": "number", "minimum": 0, "maximum": 3 },
                "animated_properties": {
                  "type": "array",
                  "items": { "type": "string" }
                }
              }
            }
          }
        }
      }
    },
    "captions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["text", "start_s", "end_s"],
        "properties": {
          "speaker": { "type": "string", "default": "NARRATOR" },
          "text": { "type": "string" },
          "start_s": { "type": "number", "minimum": 0 },
          "end_s": { "type": "number", "exclusiveMinimum": 0 },
          "safe_zone": { "type": "boolean", "default": true }
        }
      }
    },
    "audio_cues": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["type", "t_s"],
        "properties": {
          "type": { "type": "string", "enum": ["sfx", "bgm", "vo"] },
          "name": { "type": "string" },
          "t_s": { "type": "number", "minimum": 0 },
          "gain_db": { "type": "number" }
        }
      }
    }
  }
}
